---
import CodeJump from '../components/CodeJump.astro';
import MessagePanel from '../components/MessagePanel.astro';
import { analyticsId, hasFeaturedWorks, hiddenFromSearch, hasWorksOnSale, messages, site, url, version, type ShareImage } from '../lib/site';
import { favoritesShowPath, featuredShowPath, saleShowPath } from '../../scripts/lib/cinema.mjs';
import { gtagConfigScript, gtagSrc } from '../../scripts/lib/analytics.mjs';
import { HIDDEN_SITE_ROBOTS, jsonLdText, summarize, verificationMeta } from '../../scripts/lib/seo.mjs';
import { pinterestProfileLink } from '../../scripts/lib/pinterest.mjs';
import { contactLink, pageContext } from '../../scripts/lib/messages.mjs';
import { PALETTES, paletteCss, paletteScript } from '../../scripts/lib/palettes.mjs';
import PalettePicker from '../components/PalettePicker.astro';
import NameShades from '../components/NameShades.astro';
import { skipHeaderScope, skipHeaderScript } from '../../scripts/lib/skip-header.mjs';
import { splashScreens } from '../../scripts/lib/splash.mjs';

/**
 * `type`: og:type ('article' for a work); `noindex`: a page search engines should leave out (404), without canonical;
 * `jsonLd`: structured data of the page (scripts/lib/seo.mjs graphLd), null for none.
 * `message`: what a message from this page is about (scripts/lib/messages.mjs; default: the page by its title),
 * `messagePanel`: false on the contact page, which has the form itself; `messageLauncher`: false = the panel and the footer
 * link "Napište mi" without the launcher in the corner (the game, where it would cover the play).
 */
interface Props {
  title?: string; description?: string; image?: ShareImage; type?: 'website' | 'article'; noindex?: boolean; jsonLd?: object | null;
  message?: object | null; messagePanel?: boolean; messageLauncher?: boolean;
}
const { title, description: own, image, type = 'website', noindex = false, jsonLd = null, messagePanel = true, messageLauncher = true } = Astro.props;
const description = summarize(own || `${site.author} — ${site.tagline.toLowerCase()}.`);
const fullTitle = title ? `${title} · ${site.title}` : `${site.title} — ${site.tagline}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/tvorba/', label: 'Tvorba' },
  { href: '/detail-dne/', label: 'Detail dne' },
  { href: '/o-mne/', label: 'O mně' },
  { href: '/kontakt/', label: 'Kontakt' },
];
const ogImage = image ? new URL(image.src, site.url).href : undefined;
const canonical = new URL(Astro.url.pathname, site.url).href;
// "Napište mi": the panel in the corner and the footer link (to the contact page without JavaScript).
const withMessages = Boolean(messages.mode) && messagePanel;
// "Na prodej": the show of the works on sale (the cinema of the gallery), only while there are some; "Výběr" = the author's selection.
const onSale = hasWorksOnSale();
const featured = hasFeaturedWorks();
const messageContext = Astro.props.message !== undefined ? Astro.props.message : pageContext(Astro.url.pathname, title ?? site.title);
// Pages of the Tvorba section and the game open scrolled past the header (scripts/lib/skip-header.mjs).
const skipScope = skipHeaderScope(Astro.url.pathname, import.meta.env.BASE_URL);
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Colour palette: the CSS of all palettes and the visitor's choice, applied before the first paint. -->
    <meta name="theme-color" content={PALETTES[0].colors.paper} />
    <style is:inline set:html={paletteCss()} />
    <script is:inline set:html={paletteScript()} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {hiddenFromSearch && <meta name="robots" content={HIDDEN_SITE_ROBOTS} data-hidden-site />}
    {verificationMeta(site.verification).map((m) => <meta name={m.name} content={m.content} />)}
    <meta name="author" content={site.author} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="cs_CZ" />
    {!noindex && <meta property="og:url" content={canonical} />}
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content={String(image!.width)} />
        <meta property="og:image:height" content={String(image!.height)} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <!-- Installed as an app (scripts/lib/app-install.mjs): opened from the home screen without the bar of the browser. -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={site.title.split(/\s+/)[0]} />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <!-- Launch screens of the installed app on iPhone and iPad, light and dark (scripts/lib/splash.mjs) -->
    {splashScreens().map((s) => <link rel="apple-touch-startup-image" media={s.media} href={url(`/splash/${s.file}`)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Work+Sans:wght@300;400;500&display=swap&subset=latin-ext"
      rel="stylesheet"
    />
    {jsonLd && <script type="application/ld+json" set:html={jsonLdText(jsonLd)} />}
    {analyticsId && (
      <>
        <!-- Visitor statistics (Google Analytics 4), production build only: scripts/lib/analytics.mjs -->
        <script is:inline async src={gtagSrc(analyticsId)}></script>
        <script is:inline set:html={gtagConfigScript(analyticsId)} />
      </>
    )}
  </head>
  <body>
    <header class="site-header">
      <!-- "←" of the installed app (no Back of the browser there; src/lib/app-install.ts shows it) -->
      <button type="button" class="app-back" data-app-back="" hidden aria-label="Zpět" title="Zpět">←</button>
      <a class="brand" href={url('/')}>
        <span class="brand-name">{site.title}</span>
        <span class="brand-tag">{site.tagline}</span>
      </a>
      <nav aria-label="Hlavní navigace">
        <!-- "#": open a work by its code, e.g. from Instagram (src/components/CodeJump.astro) -->
        <CodeJump />
        {nav.map((n) => (
          <a href={url(n.href)} aria-current={`${path}/`.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main><slot /></main>
    <footer class:list={['site-footer', { 'with-launcher': withMessages && messageLauncher }]}>
      <span class="meta">
        <span>© {new Date().getFullYear()} <NameShades text={site.author} />
        <!-- Build version: calendar versioning, the version is the build time (YY.MMDD.HHMM, Prague time). -->
        <span class="version">· <time datetime={version.iso} title={version.title}>{version.label}</time></span></span>
        <PalettePicker />
      </span>
      <span class="links">
        <!-- the show of the visitor's favourites; shown by the script below only to a visitor with some (src/lib/favorites.ts) -->
        <a href={url(favoritesShowPath('footer'))} title="Obrazy, které jste si označili srdcem, jeden po druhém přes celou obrazovku" data-favorites-footer hidden>Oblíbené</a>
        {onSale && <a href={url(saleShowPath('footer'))} title="Obrazy na prodej jeden po druhém přes celou obrazovku">Na prodej</a>}
        {featured && <a href={url(featuredShowPath('footer'))} title="Moje nejmilejší obrazy jeden po druhém přes celou obrazovku">Výběr</a>}
        {site.instagram && <a href={`https://www.instagram.com/${site.instagram}/`} rel="me">Instagram</a>}
        {site.pinterest && <a href={pinterestProfileLink(site.pinterest)} rel="me">Pinterest</a>}
        {site.fler && <a href={site.fler}>Fler</a>}
        {withMessages && <a href={url(contactLink(messageContext))} data-message-open="" title="Napsat mi zprávu k této stránce">Napište mi</a>}
        <!-- Shown by src/lib/app-install.ts only where the site can be installed and is not yet -->
        <button type="button" class="app-install" data-app-install="" hidden title="Nainstalovat web jako aplikaci">Nainstalovat</button>
      </span>
    </footer>
    <dialog class="app-help" data-app-help="" aria-labelledby="app-help-title">
      <h2 id="app-help-title">Aplikace do telefonu</h2>
      <p data-app-help-text=""></p>
      <form method="dialog"><button class="btn" type="submit">Rozumím</button></form>
    </dialog>
    {skipScope && <script is:inline set:html={skipHeaderScript(skipScope)} />}
    {withMessages && <MessagePanel context={messageContext} launcher={messageLauncher} />}
  </body>
</html>

<script>
  // "Oblíbené" in the footer: only while the visitor has some favourites, again after every change (here or in another tab)
  import { favorites, onFavoritesChange } from '../lib/favorites';
  const favoritesLink = document.querySelector<HTMLElement>('[data-favorites-footer]');
  const showFavoritesLink = () => { if (favoritesLink) favoritesLink.hidden = favorites().length === 0; };
  showFavoritesLink();
  onFavoritesChange(showFavoritesLink);
</script>

<script>
  // Statistics: clicks on elements marked with data-track (buttons of a work), see scripts/lib/analytics.mjs.
  import { trackEvent, trackedClick } from '../../scripts/lib/analytics.mjs';
  // Links back to a listing (data-return) open it with the filters the visitor left it with; pages outside the
  // Tvorba section forget them. The main menu has no data-return: "Tvorba" there always opens the gallery afresh.
  import { applyReturnLinks } from '../lib/page-return';

  applyReturnLinks();
  // The site as an app: service worker, "Nainstalovat", "←" in the installed app.
  import '../lib/app-install';

  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
    const event = el && trackedClick(el.dataset);
    if (event) trackEvent(event.name, event.params);
  });
</script>

<style is:global>
  [hidden] { display: none !important; }
  /* The card a visitor came back to (revealReturned, src/lib/page-return.ts): a frame fading out, only while marked,
     so keyboard focus keeps its own outline. */
  .returned { outline: 2px solid var(--accent); outline-offset: 8px; animation: returned 2.4s ease-in forwards; }
  @keyframes returned { 60% { outline-color: var(--accent); } to { outline-color: transparent; } }
  @media (prefers-reduced-motion: reduce) { .returned { animation: none; } }
  /* Colours: the palettes in scripts/lib/palettes.mjs (inline in <head>, before this). */
  :root {
    --serif: 'Cormorant Garamond', Georgia, serif;
    --sans: 'Work Sans', system-ui, sans-serif;
    --gutter: clamp(16px, 4vw, 48px);
    --max: 1320px;
  }
  * { box-sizing: border-box; }
  /* Checkboxes in the colours of the palette: a native one stays white with a blue focus ring whatever the palette
     (accent-color tints only the ticked box). Paper with a quiet frame, ticked = ink with a paper tick, the focus ring
     in the accent colour. In forced colours (high contrast) the native box is kept. */
  input[type='checkbox'] {
    appearance: none; -webkit-appearance: none; margin: 0; flex: none; cursor: pointer;
    display: inline-grid; place-content: center; width: 1.05em; height: 1.05em; vertical-align: -0.15em;
    background: var(--paper); border: 1px solid var(--ink-soft); border-radius: 3px;
  }
  input[type='checkbox']::before {
    content: ''; width: 0.62em; height: 0.62em; background: var(--paper); transform: scale(0); transition: transform .12s ease-in-out;
    clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%);
  }
  input[type='checkbox']:hover { border-color: var(--ink); }
  input[type='checkbox']:checked { background: var(--ink); border-color: var(--ink); }
  input[type='checkbox']:checked::before { transform: scale(1); }
  input[type='checkbox']:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { input[type='checkbox']::before { transition: none; } }
  @media (forced-colors: active) { input[type='checkbox'] { appearance: auto; -webkit-appearance: auto; } }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; background: var(--paper); color: var(--ink);
    font: 300 17px/1.65 var(--sans); min-height: 100vh; display: flex; flex-direction: column;
  }
  main { flex: 1; width: 100%; max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter) 80px; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 400; line-height: 1.15; letter-spacing: 0.005em; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0.2em 0 0.4em; }
  h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  a { color: inherit; text-decoration-color: var(--line); text-underline-offset: 3px; }
  a:hover { text-decoration-color: currentColor; }
  p { max-width: 62ch; }
  .muted { color: var(--ink-soft); }
  .eyebrow { font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); }

  .site-header {
    display: flex; align-items: baseline; justify-content: space-between; gap: 24px; flex-wrap: wrap;
    max-width: var(--max); width: 100%; margin: 0 auto; padding: 28px var(--gutter) 36px;
  }
  .brand { text-decoration: none; display: flex; flex-direction: column; }
  .brand-name { font-family: var(--serif); font-size: 1.9rem; line-height: 1; }
  .brand-tag { font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); margin-top: 6px; }
  .site-header nav { display: flex; gap: 28px; }
  .site-header nav a { text-decoration: none; font-size: 0.95rem; padding-bottom: 3px; border-bottom: 1px solid transparent; white-space: nowrap; }
  /* Four items on a narrow phone too: closer together and a little smaller, each on one line. */
  @media (max-width: 480px) {
    .site-header nav { gap: clamp(8px, 3.6vw, 20px); }
    .site-header nav a { font-size: 0.9rem; }
  }
  .site-header nav a[aria-current='page'], .site-header nav a:hover { border-color: var(--ink); }
  /* "←" of the installed app, before the name of the site. */
  .app-back {
    align-self: center; margin-right: -12px; padding: 4px 10px; font: 400 1.5rem/1 var(--sans); color: var(--ink);
    background: none; border: 1px solid var(--line); border-radius: 999px; cursor: pointer;
  }
  .app-back:hover { border-color: var(--ink); }
  .app-back:focus-visible, .app-install:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  /* "Nainstalovat" looks like the other links of the footer. */
  .app-install {
    font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer;
    text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px;
  }
  .app-install:hover { text-decoration-color: currentColor; }
  .app-help {
    max-width: min(26rem, calc(100vw - 32px)); padding: 24px 28px; border: 1px solid var(--line); border-radius: 4px;
    background: var(--paper); color: var(--ink);
  }
  .app-help::backdrop { background: color-mix(in srgb, var(--paper) 75%, transparent); }
  .app-help { box-shadow: var(--shadow-deep); }
  .app-help h2 { margin: 0 0 8px; font-size: 1.6rem; }
  .app-help form { margin: 16px 0 0; }
  .app-help .btn { background: none; color: inherit; font: inherit; cursor: pointer; }

  .site-footer {
    max-width: var(--max); width: 100%; margin: 0 auto; padding: 28px var(--gutter);
    border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    font-size: 0.85rem; color: var(--ink-soft);
  }
  .site-footer .meta { display: flex; gap: 8px 20px; flex-wrap: wrap; align-items: center; }
  .site-footer .links { display: flex; gap: 20px; flex-wrap: wrap; align-items: center; }
  /* Room under the footer for the floating "Napište mi" launcher, so it never covers the footer links. */
  .site-footer.with-launcher { padding-bottom: 88px; }
  .site-footer .version { opacity: 0.6; font-variant-numeric: tabular-nums; letter-spacing: 0.02em; }
  .site-footer .version time { cursor: help; }
  /* On a phone the footer is one column aligned left: the © and version, the colour dots on a row of their own,
     then the links under a thin line (still wrapped in rows, spaced like the left part). */
  @media (max-width: 640px) {
    .site-footer { flex-direction: column; align-items: flex-start; }
    .site-footer .meta { flex-direction: column; align-items: flex-start; }
    .site-footer .links { gap: 8px 20px; align-self: stretch; padding-top: 16px; border-top: 1px solid var(--line); }
  }

  .badge {
    display: inline-block; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;
    padding: 3px 9px; border: 1px solid var(--line); border-radius: 99px; color: var(--ink-soft);
  }
  .badge.available { color: var(--ok); border-color: currentColor; }
  .btn {
    display: inline-block; padding: 11px 22px; border: 1px solid var(--ink); border-radius: 2px;
    text-decoration: none; font-size: 0.92rem; letter-spacing: 0.03em; transition: background .15s, color .15s;
  }
  .btn:hover { background: var(--ink); color: var(--paper); }
</style>
