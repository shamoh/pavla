---
import MessagePanel from '../components/MessagePanel.astro';
import { analyticsId, messages, site, url, version, type ShareImage } from '../lib/site';
import { gtagConfigScript, gtagSrc } from '../../scripts/lib/analytics.mjs';
import { jsonLdText, summarize, verificationMeta } from '../../scripts/lib/seo.mjs';
import { contactLink, pageContext } from '../../scripts/lib/messages.mjs';

/**
 * `type`: og:type ('article' for a work); `noindex`: a page search engines should leave out (404), without canonical;
 * `jsonLd`: structured data of the page (scripts/lib/seo.mjs graphLd), null for none.
 * `message`: what a message from this page is about (scripts/lib/messages.mjs; default: the page by its title),
 * `messagePanel`: false on the contact page, which has the form itself.
 */
interface Props {
  title?: string; description?: string; image?: ShareImage; type?: 'website' | 'article'; noindex?: boolean; jsonLd?: object | null;
  message?: object | null; messagePanel?: boolean;
}
const { title, description: own, image, type = 'website', noindex = false, jsonLd = null, messagePanel = true } = Astro.props;
const description = summarize(own || `${site.author} — ${site.tagline.toLowerCase()}.`);
const fullTitle = title ? `${title} · ${site.title}` : `${site.title} — ${site.tagline}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/tvorba', label: 'Tvorba' },
  { href: '/o-mne', label: 'O mně' },
  { href: '/kontakt', label: 'Kontakt' },
];
const ogImage = image ? new URL(image.src, site.url).href : undefined;
const canonical = new URL(Astro.url.pathname, site.url).href;
// "Napište mi": the panel in the corner and the footer link (to the contact page without JavaScript).
const withMessages = Boolean(messages.mode) && messagePanel;
const messageContext = Astro.props.message !== undefined ? Astro.props.message : pageContext(Astro.url.pathname, title ?? site.title);
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {verificationMeta(site.verification).map((m) => <meta name={m.name} content={m.content} />)}
    <meta name="author" content={site.author} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="cs_CZ" />
    {!noindex && <meta property="og:url" content={canonical} />}
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content={String(image!.width)} />
        <meta property="og:image:height" content={String(image!.height)} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Work+Sans:wght@300;400;500&display=swap&subset=latin-ext"
      rel="stylesheet"
    />
    {jsonLd && <script type="application/ld+json" set:html={jsonLdText(jsonLd)} />}
    {analyticsId && (
      <>
        <!-- Visitor statistics (Google Analytics 4), production build only: scripts/lib/analytics.mjs -->
        <script is:inline async src={gtagSrc(analyticsId)}></script>
        <script is:inline set:html={gtagConfigScript(analyticsId)} />
      </>
    )}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={url('/')}>
        <span class="brand-name">{site.title}</span>
        <span class="brand-tag">{site.tagline}</span>
      </a>
      <nav aria-label="Hlavní navigace">
        {nav.map((n) => (
          <a href={url(n.href)} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>
        © {new Date().getFullYear()} {site.author}
        <!-- Build version: calendar versioning, the version is the build time (YY.MMDD.HHMM, Prague time). -->
        <span class="version">· <time datetime={version.iso} title={version.title}>{version.label}</time></span>
      </span>
      <span class="links">
        {site.instagram && <a href={`https://www.instagram.com/${site.instagram}/`} rel="me">Instagram</a>}
        {site.fler && <a href={site.fler}>Fler</a>}
        {withMessages && <a href={url(contactLink(messageContext))} data-message-open="">Napsat k této stránce</a>}
      </span>
    </footer>
    {withMessages && <MessagePanel context={messageContext} />}
  </body>
</html>

<script>
  // Statistics: clicks on elements marked with data-track (buttons of a work), see scripts/lib/analytics.mjs.
  import { trackEvent, trackedClick } from '../../scripts/lib/analytics.mjs';

  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
    const event = el && trackedClick(el.dataset);
    if (event) trackEvent(event.name, event.params);
  });
</script>

<style is:global>
  [hidden] { display: none !important; }
  :root {
    --paper: #f7f4ee;
    --paper-2: #efeae0;
    --ink: #2b2724;
    --ink-soft: #6d655c;
    --line: #ddd5c7;
    --accent: #4f7a8a;
    --ok: #4f7a5a;
    --serif: 'Cormorant Garamond', Georgia, serif;
    --sans: 'Work Sans', system-ui, sans-serif;
    --gutter: clamp(16px, 4vw, 48px);
    --max: 1320px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #1c1a18; --paper-2: #252220; --ink: #ece6dc; --ink-soft: #a89f93;
      --line: #3a3531; --accent: #8fb7c4; --ok: #93bf9c;
    }
  }
  * { box-sizing: border-box; }
  input[type='checkbox'] { accent-color: var(--ink); }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; background: var(--paper); color: var(--ink);
    font: 300 17px/1.65 var(--sans); min-height: 100vh; display: flex; flex-direction: column;
  }
  main { flex: 1; width: 100%; max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter) 80px; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 400; line-height: 1.15; letter-spacing: 0.005em; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0.2em 0 0.4em; }
  h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  a { color: inherit; text-decoration-color: var(--line); text-underline-offset: 3px; }
  a:hover { text-decoration-color: currentColor; }
  p { max-width: 62ch; }
  .muted { color: var(--ink-soft); }
  .eyebrow { font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); }

  .site-header {
    display: flex; align-items: baseline; justify-content: space-between; gap: 24px; flex-wrap: wrap;
    max-width: var(--max); width: 100%; margin: 0 auto; padding: 28px var(--gutter) 36px;
  }
  .brand { text-decoration: none; display: flex; flex-direction: column; }
  .brand-name { font-family: var(--serif); font-size: 1.9rem; line-height: 1; }
  .brand-tag { font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); margin-top: 6px; }
  .site-header nav { display: flex; gap: 28px; }
  .site-header nav a { text-decoration: none; font-size: 0.95rem; padding-bottom: 3px; border-bottom: 1px solid transparent; }
  .site-header nav a[aria-current='page'], .site-header nav a:hover { border-color: var(--ink); }

  .site-footer {
    max-width: var(--max); width: 100%; margin: 0 auto; padding: 28px var(--gutter);
    border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    font-size: 0.85rem; color: var(--ink-soft);
  }
  .site-footer .links { display: flex; gap: 20px; }
  .site-footer .version { opacity: 0.6; font-variant-numeric: tabular-nums; letter-spacing: 0.02em; }
  .site-footer .version time { cursor: help; }

  .badge {
    display: inline-block; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;
    padding: 3px 9px; border: 1px solid var(--line); border-radius: 99px; color: var(--ink-soft);
  }
  .badge.available { color: var(--ok); border-color: currentColor; }
  .btn {
    display: inline-block; padding: 11px 22px; border: 1px solid var(--ink); border-radius: 2px;
    text-decoration: none; font-size: 0.92rem; letter-spacing: 0.03em; transition: background .15s, color .15s;
  }
  .btn:hover { background: var(--ink); color: var(--paper); }
</style>
