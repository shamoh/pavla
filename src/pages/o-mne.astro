---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { photoImageUrl, site } from '../lib/site';
import { breadcrumbLd, graphLd, personLd } from '../../scripts/lib/seo.mjs';

const description = 'Maluji pro radost už dlouhé roky. Nejvíc mě chytil akvarel, na procházkách skicuji tužkou a brush penem. Kdo jsem a jak maluji.';
// For search engines: a profile page about the author.
const jsonLd = graphLd(
  { '@type': 'ProfilePage', '@id': new URL('/o-mne/', site.url).href, url: new URL('/o-mne/', site.url).href, name: `O mně – ${site.author}`, inLanguage: 'cs', mainEntity: { '@id': new URL('/#autorka', site.url).href } },
  personLd(site, { image: photoImageUrl('portret') ?? undefined }),
  breadcrumbLd(site, [{ name: 'Úvod', path: '/' }, { name: 'O mně', path: '/o-mne/' }]),
);
---
<Base title="O mně" description={description} jsonLd={jsonLd}>
  <div class="about">
    <header>
      <p class="eyebrow">O mně</p>
      <h1>{site.author}</h1>
    </header>
    <!-- Wide photo on top (fotky/o-mne-uvod.jpg of the content repository), portrait next to the text (portret.jpg). -->
    <Photo name="o-mne-uvod" sizes="(max-width: 1100px) 100vw, 1100px" eager class="lead" aspect="2 / 1" />
    <div class="body">
      <div class="text">
        <!-- Own text in the first person; the list of texts to review is kept with the content of the site. -->
        <p>
          Maluji pro radost. Je to moje velká vášeň a dlouholetý koníček – chvíle, kdy se svět zpomalí
          a zbude jen papír, barva a voda.
        </p>
        <p>
          Posledních pár let mě nejvíc chytil akvarel. Baví mě, že se nedá úplně ovládat: voda si vždycky
          trochu dělá, co chce, a právě to bývá na obraze nejhezčí.
        </p>
        <p>
          Na procházky a plenéry s sebou nosím malý skicák. Kromě rychlých akvarelů v něm přibývají skici
          tužkou a brush penem – krajina, stromy, zvířata, cokoli, co mě cestou zastaví.
        </p>
        <p class="muted">
          Obrazy maluji hlavně pro sebe. Když vám ale některý přiroste k srdci, ráda ho pustím dál, do dobrých
          rukou – stačí se ozvat.
        </p>
      </div>
      <Photo name="portret" sizes="(max-width: 800px) 100vw, 300px" class="portrait" />
    </div>
  </div>
</Base>
<style>
  .about { max-width: 1100px; }
  .about header { margin-bottom: 32px; }
  .about h1 { margin: 0.1em 0 0; }
  /* Page selectors (.about …) outrank the scoped `.photo { margin: 0 }` of the Photo component. */
  .about :global(.lead) { margin: 0 0 clamp(40px, 6vw, 72px); }
  .body { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: clamp(24px, 6vw, 80px); align-items: start; }
  .body:not(:has(:global(.portrait))) { grid-template-columns: minmax(0, 1fr); }
  .text { font-size: 1.08rem; max-width: 62ch; }
  .text p:first-child { margin-top: 0; }
  @media (max-width: 800px) {
    .body { grid-template-columns: 1fr; }
    .about :global(.portrait) { max-width: 360px; }
  }
</style>
