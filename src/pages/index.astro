---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import Cover from '../components/Cover.astro';
import { coverShareImage, coverWorkId, getHome, getWorks, site, url } from '../lib/site';
import { hiddenInList } from '../../scripts/lib/random-pick.mjs';

const RECENT = 6;
const works = getWorks();
// Text and cover from uvod.yaml of the content repository (content/home.yaml): its own photo, `cover`, or one of the
// newest works of the author's selection at random per visit.
const home = getHome();
// "Nejnovější" below: the newest works except the one on the cover; one more is rendered for when the cover is one of them.
const recent = works.slice(0, RECENT + 1);
const recentHidden = hiddenInList(recent.map((w) => w.id), coverWorkId(home.cover), RECENT);
---
<Base image={coverShareImage(home.cover)}>
  {home.cover ? (
    <section class="hero">
      <Cover cover={home.cover} sizes="(max-width: 900px) 100vw, 60vw" eager exclude="#recent" show={RECENT} />
      <div class="hero-text">
        <p class="eyebrow">{site.tagline}</p>
        <h1>Barvy, voda <br />a trochu náhody</h1>
        {home.description ? <p class="muted desc">{home.description}</p> : null}
        <a class="btn" href={url('/tvorba')}>Prohlédnout tvorbu</a>
      </div>
    </section>
  ) : (
    <section class="empty">
      <p class="eyebrow">{site.tagline}</p>
      <p>Obrazy tu brzy přibudou.</p>
      {site.instagram && (
        <p class="muted">Než je sem nahraji, co právě maluji, najdete <a href={`https://www.instagram.com/${site.instagram}/`} rel="me">na Instagramu</a>.</p>
      )}
    </section>
  )}

  {recentHidden.some((h) => !h) && (
    <section>
      <div class="section-head">
        <h2>Nejnovější</h2>
        <a href={url('/tvorba')}>Celá tvorba →</a>
      </div>
      <div class="grid" id="recent">{recent.map((w, i) => <WorkCard work={w} hidden={recentHidden[i]} />)}</div>
    </section>
  )}
</Base>
<style>
  .hero { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(24px, 5vw, 72px); align-items: center; margin-bottom: 96px; }
  .hero-text h1 { margin-top: 0.1em; }
  .desc { white-space: pre-line; }
  .hero-text .btn { margin-top: 12px; }
  .section-head { display: flex; justify-content: space-between; align-items: baseline; border-top: 1px solid var(--line); padding-top: 24px; margin-bottom: 28px; }
  .section-head h2 { margin: 0; }
  .grid { columns: 3 300px; column-gap: 36px; }
  .empty { max-width: 36rem; padding: 48px 0 96px; }
  .empty p:not(.eyebrow):not(.muted) { font-family: var(--serif); font-size: 1.8rem; margin: 0.2em 0; }
  @media (max-width: 900px) { .hero { grid-template-columns: 1fr; margin-bottom: 64px; } }
</style>
