---
// The game Detail dne: three daily puzzles "from which work is this close-up?" (src/lib/detail-game.ts, rules
// scripts/lib/detail-game.mjs, data /detail-dne/data.json). For now a pilot: no link leads here, search engines leave it out
// (noindex, not in the sitemap), the progress stays in the browser of the player.
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/site';
---
<Base title="Detail dne" description="Denní hádanka z mých obrazů: ze kterého obrazu je tento detail? Tři úrovně každý den." noindex messagePanel={false}>
  <div class="detail-game" data-src={url('/detail-dne/data.json')}>
    <svg width="0" height="0" class="filters" aria-hidden="true"><filter id="game-wave" x="0" y="0" width="100%" height="100%"><feTurbulence type="turbulence" baseFrequency="0.012 0.02" numOctaves="2" seed="4" /><feDisplacementMap data-wave-map in="SourceGraphic" scale="0" xChannelSelector="R" yChannelSelector="G" /></filter></svg>
    <div class="top">
      <header class="game-head">
        <h1>Detail dne <span data-number></span></h1>
        <div class="stats" data-stats></div>
      </header>
      <div class="archive-bar" data-archive-bar hidden></div>
      <div class="levels" data-levels></div>
    </div>
    <div data-content><p class="empty">Připravuji dnešní detail…</p></div>
    <section class="shelf">
      <h2>Archiv</h2>
      <p class="note">Starší dny můžeš dohrát kdykoli, za poloviční kapky a bez vlivu na sérii.</p>
      <div data-archive></div>
    </section>
    <section class="shelf">
      <h2>Moje sbírka</h2>
      <div data-collection></div>
      <p class="note">Kapky, série i sbírka se ukládají jen v tomto prohlížeči.</p>
    </section>
  </div>
</Base>
<style is:global>
  /* Everything under .detail-game: the script makes most of it (scoped styles would not reach it). */
  .detail-game { --bleed: 32px; max-width: 1040px; margin: 0 auto; }
  .detail-game .filters { position: absolute; }
  .detail-game button { font: inherit; color: inherit; cursor: pointer; }
  .detail-game .game-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 16px; margin-bottom: 10px; }
  .detail-game h1 { margin: 0 auto 0 0; white-space: nowrap; }
  /* Numbers of the same width, so the line keeps its length while the drops grow. */
  .detail-game .stats { display: flex; flex-wrap: wrap; gap: 2px 14px; font-size: .88rem; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .detail-game .stats b { color: var(--ink); font-weight: 500; }
  .detail-game .stats span { white-space: nowrap; }
  .detail-game .levels { display: flex; gap: 6px; margin-bottom: 12px; }
  .detail-game .level { flex: 1; background: transparent; border: 1px solid var(--line); border-radius: 99px; padding: 7px 8px; font-size: .9rem; white-space: nowrap; }
  .detail-game .level small { color: var(--ink-soft); font-size: .78rem; }
  .detail-game .level[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .detail-game .level[aria-pressed='true'] small { color: inherit; }
  /* Only on a day of the archive: one slim line over the levels. */
  .detail-game .archive-bar { display: flex; align-items: center; gap: 6px; margin-bottom: 8px; font-size: .84rem; color: var(--ink-soft); }
  .detail-game .archive-bar[hidden] { display: none; }
  .detail-game .archive-bar .which { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: center; }
  .detail-game .archive-bar .half { color: var(--accent); }
  .detail-game .archive-bar .step, .detail-game .archive-bar .today { background: transparent; border: 1px solid var(--line); border-radius: 99px; padding: 2px 10px; line-height: 1.3; }
  .detail-game .archive-bar .step:disabled { opacity: .35; cursor: default; }
  .detail-game .days { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 6px; margin-bottom: 10px; }
  .detail-game .day { display: flex; justify-content: space-between; align-items: center; gap: 6px; background: transparent; border: 1px solid var(--line); border-radius: 6px; padding: 6px 8px; font-size: .84rem; font-variant-numeric: tabular-nums; }
  .detail-game .day[aria-pressed='true'] { border-color: var(--ink); }
  .detail-game .marks { display: flex; gap: 2px; }
  .detail-game .marks .mark { width: 1.1em; text-align: center; }
  .detail-game .mark.solved { color: var(--ok); }
  .detail-game .mark.lost { color: var(--error); }
  .detail-game .mark.open { color: var(--ink-soft); }
  .detail-game .game { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  /* Side by side on a big screen and on a phone on its side (TWO_COLUMNS in src/lib/detail-game.ts). */
  @media (min-width: 800px), (orientation: landscape) and (min-width: 560px) { .detail-game .game { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; align-items: start; } }
  /* On a phone one line: the title, the drops and the series; the rank waits for a bigger screen. */
  @media (max-width: 799px) {
    .detail-game .game-head { flex-wrap: nowrap; align-items: center; margin-bottom: 8px; }
    .detail-game h1 { font-size: 1.6rem; }
    .detail-game .stats { font-size: .8rem; flex-wrap: nowrap; }
    .detail-game .stats .rank { display: none; }
    .detail-game .levels { margin-bottom: 10px; }
    .detail-game .level { padding: 5px 6px; }
  }
  /* A phone on its side is low: the title with the drops and the levels in one line, the stage gets the height (the line of the
     archive under them). */
  @media (orientation: landscape) and (max-height: 500px) {
    .detail-game .top { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px; margin-bottom: 8px; }
    .detail-game .game-head { flex-direction: column; align-items: flex-start; gap: 0; margin: 0; }
    .detail-game h1 { font-size: 1.35rem; line-height: 1.1; margin: 0; }
    .detail-game .stats { font-size: .74rem; flex-wrap: nowrap; gap: 0 10px; }
    .detail-game .stats .rank { display: none; }
    .detail-game .levels { flex: 1; min-width: 280px; margin: 0; }
    .detail-game .level { padding: 5px 6px; }
    .detail-game .archive-bar { order: 3; flex-basis: 100%; margin: 0; }
  }

  /* The stage: a window on the work, moved by a transform so that zooming out is one smooth movement. Its size never changes
     during a round (fitStage). The picture reaches --bleed beyond the window, so a wave or a mist never tears its edge; the
     raster masks the window itself (.clip). */
  .detail-game .stage { position: relative; width: 100%; margin: 0 auto; aspect-ratio: 1; overflow: hidden; background: var(--paper-2); border: 1px solid var(--line); touch-action: manipulation; }
  .detail-game .clip { position: absolute; inset: 0; overflow: hidden; }
  .detail-game .view { position: absolute; inset: calc(-1 * var(--bleed)); overflow: hidden; transition: filter .7s ease; }
  .detail-game .pixels { position: absolute; left: var(--bleed); top: var(--bleed); width: calc(100% - 2 * var(--bleed)); height: calc(100% - 2 * var(--bleed)); image-rendering: pixelated; }
  .detail-game .stage img { position: absolute; left: var(--bleed); top: var(--bleed); width: calc(100% - 2 * var(--bleed)); height: auto; max-width: none; transform-origin: 0 0; transition: transform .7s ease; }
  .detail-game .stage.reveal img { transition-duration: 1.8s; transition-timing-function: cubic-bezier(.2, .7, .2, 1); }
  .detail-game .drop { position: absolute; top: -24px; width: 14px; height: 18px; border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%; animation: game-fall var(--t) ease-in var(--d) forwards; opacity: 0; }
  @keyframes game-fall { 0% { opacity: 0; transform: translateY(0); } 10% { opacity: .9; } 100% { opacity: 0; transform: translateY(var(--h)); } }
  @media (prefers-reduced-motion: reduce) { .detail-game .stage img, .detail-game .stage.reveal img { transition: none; } .detail-game .drop { display: none; } }

  /* The status keeps its height in every state of the round (playing, a hint, the end), so the thumbnails never move. */
  .detail-game .status { margin-bottom: 10px; }
  .detail-game .status p { margin: 0; }
  .detail-game .ask { font-size: 1rem; font-weight: 500; line-height: 1.3; }
  /* Always one line (on a narrow phone the end is cut), so the status keeps its height. */
  .detail-game .tries { font-size: .84rem; line-height: 1.25; color: var(--ink-soft); min-height: 1.25em; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .detail-game .tries b { color: var(--ink); font-weight: 600; }
  /* The tries as pips: missed, now, hit, left. */
  .detail-game .pips { display: inline-flex; gap: 7px; margin-right: 8px; vertical-align: -1px; }
  .detail-game .pip { width: 11px; height: 11px; border-radius: 50%; border: 1.5px solid var(--line); box-sizing: border-box; }
  .detail-game .pip.miss { background: var(--error); border-color: var(--error); }
  .detail-game .pip.hit { background: var(--ok); border-color: var(--ok); }
  .detail-game .pip.now { border-color: var(--ink); box-shadow: 0 0 0 2px var(--paper), 0 0 0 3px var(--ink); }
  .detail-game .hint { font-size: .86rem; line-height: 1.25; min-height: 2.5em; color: var(--ink-soft); }
  .detail-game .hint b { color: var(--ink); font-weight: 500; }
  .detail-game .hint.waiting { opacity: .65; }
  .detail-game .options { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
  /* Lower than square: most works are wider than high, and on a phone all thumbnails and the stage fit on the screen. */
  .detail-game .option { padding: 0; aspect-ratio: 4 / 3; background: var(--paper-2); border: 2px solid transparent; display: block; position: relative; transition: opacity .3s ease; }
  .detail-game .option img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .detail-game .option:hover:not(:disabled), .detail-game .option:focus-visible { border-color: var(--accent); outline: none; }
  .detail-game .option:disabled { cursor: default; }
  .detail-game .option.out img { opacity: .22; }
  /* Why a thumbnail is out: over the picture, so nothing moves. */
  .detail-game .because { position: absolute; left: 0; right: 0; bottom: 0; padding: 3px 4px; background: var(--paper); color: var(--ink); border-top: 1px solid var(--line); font-size: .74rem; line-height: 1.2; text-align: center; }
  .detail-game .option.right { border-color: var(--ok); opacity: 1; }
  .detail-game .option.wrong { border-color: var(--error); }

  /* The end of a round: the verdict in the status gets its colour (the same size, nothing moves). */
  .detail-game .status.won .ask { color: var(--ok); }
  .detail-game .status.lost .ask { color: var(--error); }
  /* The whole work after the end is a link to its page. */
  .detail-game .whole-link { position: absolute; inset: 0; z-index: 1; }
  .detail-game .whole-link:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }

  /* The card of the end comes under the thumbnails: nothing the player looks at moves. The verdict first, in its colour. */
  .detail-game .result { margin-top: 14px; padding: 12px 16px 14px; background: var(--paper-2); border: 1px solid var(--line); border-top: 4px solid var(--line); scroll-margin-bottom: 16px; }
  .detail-game .result.won { border-top-color: var(--ok); }
  .detail-game .result.lost { border-top-color: var(--error); }
  .detail-game .verdict { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; margin: 0 0 10px; font-family: var(--serif); font-size: 1.7rem; font-weight: 500; line-height: 1.15; }
  .detail-game .won .verdict { color: var(--ok); }
  .detail-game .lost .verdict { color: var(--error); }
  .detail-game .verdict .gain { font-family: var(--sans); font-size: .95rem; color: var(--ink); }
  .detail-game .lost .verdict .gain { color: var(--ink-soft); font-weight: 400; }
  .detail-game .result h2 { font-size: 1.35rem; margin: 0; }
  .detail-game .result .sub { font-size: .88rem; color: var(--ink-soft); margin: 2px 0 8px; }
  .detail-game .result .done { margin: 10px 0 0; }
  .detail-game .result .text { font-size: .94rem; margin: 0 0 12px; }
  .detail-game .rankup { color: var(--accent); font-weight: 500; margin: -4px 0 8px; }
  /* Always one line: short words, the full ones in the bubble. */
  .detail-game .actions { display: flex; flex-wrap: nowrap; gap: 8px; align-items: center; }
  .detail-game .action { border: 1px solid var(--ink); background: var(--ink); color: var(--paper); padding: 6px 14px; border-radius: 99px; font-size: .88rem; text-decoration: none; white-space: nowrap; }
  .detail-game .action.quiet { background: transparent; color: var(--ink); }

  .detail-game .shelf { margin-top: 28px; border-top: 1px solid var(--line); padding-top: 12px; }
  .detail-game .shelf h2 { font-size: 1.4rem; margin: 0 0 8px; }
  .detail-game .collected { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
  .detail-game .collected img { height: 64px; width: auto; display: block; background: var(--paper-2); }
  .detail-game .pigments { display: flex; flex-wrap: wrap; gap: 4px; }
  .detail-game .pigment { width: 22px; height: 22px; border-radius: 50%; border: 1px solid var(--line); }
  .detail-game .empty, .detail-game .note { font-size: .9rem; color: var(--ink-soft); margin: 0 0 10px; }
</style>
<script>
  import { startGame } from '../../lib/detail-game';
  const root = document.querySelector('.detail-game') as HTMLElement | null;
  if (root) startGame(root);
</script>
