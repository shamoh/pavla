---
// The game Detail dne: three daily puzzles "from which work is this close-up?" (src/lib/detail-game.ts, rules
// scripts/lib/detail-game.mjs, data /detail-dne/data.json). For now a pilot: no link leads here, search engines leave it out
// (noindex, not in the sitemap), the progress stays in the browser of the player. The markup (gamePageHtml) and the look
// (src/styles/detail-game.css) are shared with the prototype of the game (.prototypes/detail-dne.html).
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/site';
import { gamePageHtml } from '../../../scripts/lib/detail-game-page.mjs';
import '../../styles/detail-game.css';
---
<Base title="Detail dne" description="Denní hádanka z mých obrazů: ze kterého obrazu je tento detail? Tři úrovně každý den." noindex messagePanel={false}>
  <Fragment set:html={gamePageHtml({ src: url('/detail-dne/data.json') })} />
</Base>
<script>
  import { startGame } from '../../lib/detail-game';
  const root = document.querySelector('.detail-game') as HTMLElement | null;
  if (root) startGame(root);
</script>
