---
// A collection of works (e.g. one plein-air trip): /tvorba/kolekce/<slug>/
// Cover (cropped to 3:2 around `focus`): the collection's own photo (_cover.jpg in the collection folder of the content repository),
// otherwise `cover: <id>` or `cover: <id>#<detail>` from its YAML, otherwise its newest work.
import Base from '../../../layouts/Base.astro';
import WorkGallery from '../../../components/WorkGallery.astro';
import Cover from '../../../components/Cover.astro';
import { collectionShareImage, getCollections, site, url, type Collection } from '../../../lib/site';
import { breadcrumbLd, collectionPageLd, graphLd } from '../../../../scripts/lib/seo.mjs';

export function getStaticPaths() {
  return getCollections().map((collection) => ({ params: { collection: collection.slug }, props: { collection } }));
}
interface Props { collection: Collection }
const { collection } = Astro.props;
const { title, description, works } = collection;
const path = `/tvorba/kolekce/${collection.slug}/`;
const pageDescription = description?.trim() || `${title} – kolekce maleb a kreseb, ${site.author}.`;
const jsonLd = graphLd(
  collectionPageLd(site, { path, name: title, description: pageDescription, items: works, itemPath: (w) => `/tvorba/${w.year}/${w.key}/` }),
  breadcrumbLd(site, [{ name: 'Úvod', path: '/' }, { name: 'Tvorba', path: '/tvorba/' }, { name: 'Kolekce', path: '/tvorba/kolekce/' }, { name: title, path }]),
);
---
<Base title={title} description={pageDescription} image={collectionShareImage(collection)} jsonLd={jsonLd}>
  <p class="back"><a href={url('/tvorba/')}>← Tvorba</a></p>
  <header class="intro">
    <div>
      <p class="eyebrow">Kolekce</p>
      <h1>{title}</h1>
      {description && <p class="desc">{description}</p>}
    </div>
    <Cover cover={collection.cover} sizes="(max-width: 900px) 100vw, 55vw" eager />
  </header>
  <WorkGallery works={works} collection={collection.slug} />
</Base>
<style>
  .back { margin: -12px 0 24px; font-size: 0.9rem; }
  .back a { text-decoration: none; color: var(--ink-soft); }
  .intro { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(24px, 5vw, 64px); align-items: center; margin-bottom: 56px; }
  .intro h1 { margin-top: 0.1em; }
  .desc { white-space: pre-line; font-size: 1.05rem; }
  @media (max-width: 900px) { .intro { grid-template-columns: 1fr; } }
</style>
