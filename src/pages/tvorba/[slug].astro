---
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';
import { getWorks, site, statusLabel, formatSize, formatPrice, url, type Work } from '../../lib/site';

export function getStaticPaths() {
  const works = getWorks();
  return works.map((work, i) => ({ params: { slug: work.slug }, props: { work, prev: works[i - 1], next: works[i + 1] } }));
}
interface Props { work: Work; prev?: Work; next?: Work }
const { work, prev, next } = Astro.props;
const date = work.date.toLocaleDateString('cs-CZ', { month: 'long', year: 'numeric' });
const mail = site.email && `mailto:${site.email}?subject=${encodeURIComponent(`Zájem o obraz „${work.title}“`)}`;
---
<Base title={work.title} description={work.description?.trim() || `${work.title} — ${work.technique}`} image={`/works/${work.slug}/1600.jpg`}>
  <p class="back"><a href={url('/tvorba')}>← Tvorba</a></p>
  <article class="work">
    <a class="zoom" href={url(`/works/${work.slug}/${work.image.widths[work.image.widths.length - 1]}.jpg`)} title="Otevřít v plném rozlišení">
      <Picture work={work} sizes="(max-width: 900px) 100vw, 64vw" eager />
    </a>
    <div class="info">
      <h1>{work.title}</h1>
      <dl>
        <dt>Technika</dt><dd>{work.technique}</dd>
        {work.support && <><dt>Podklad</dt><dd>{work.support}</dd></>}
        {work.size_cm && <><dt>Rozměr</dt><dd>{formatSize(work.size_cm)}</dd></>}
        <dt>Vzniklo</dt><dd>{date}</dd>
      </dl>
      {work.description && <p class="desc">{work.description}</p>}
      <div class="status">
        <span class:list={['badge', { available: work.status === 'available' }]}>{statusLabel[work.status]}</span>
        {work.status === 'available' && work.price && <span class="price">{formatPrice(work.price)}</span>}
      </div>
      {work.status === 'available' && (
        <div class="actions">
          {work.fler && <a class="btn" href={work.fler}>Koupit na Fleru</a>}
          {mail && <a class="btn ghost" href={mail}>Napsat autorce</a>}
        </div>
      )}
      {work.tags.length > 0 && (
        <p class="tags">{work.tags.map((t) => <a href={url(`/tvorba?tag=${encodeURIComponent(t)}`)}>#{t}</a>)}</p>
      )}
    </div>
  </article>
  <nav class="pager" aria-label="Další díla">
    {prev ? <a href={url(`/tvorba/${prev.slug}`)}>← {prev.title}</a> : <span />}
    {next && <a href={url(`/tvorba/${next.slug}`)}>{next.title} →</a>}
  </nav>
</Base>
<style>
  .back { margin: -12px 0 24px; font-size: 0.9rem; }
  .back a { text-decoration: none; color: var(--ink-soft); }
  .work { display: grid; grid-template-columns: 1.8fr 1fr; gap: clamp(24px, 5vw, 64px); align-items: start; }
  .zoom { display: block; cursor: zoom-in; }
  .zoom :global(picture) { box-shadow: 0 2px 4px rgba(0,0,0,.05), 0 24px 48px -24px rgba(0,0,0,.3); }
  .info { position: sticky; top: 24px; }
  .info h1 { margin-top: 0; }
  dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 20px; font-size: 0.93rem; margin: 0 0 20px; }
  dt { color: var(--ink-soft); }
  dd { margin: 0; }
  .desc { white-space: pre-line; }
  .status { display: flex; gap: 16px; align-items: center; margin: 24px 0 16px; }
  .price { font-family: var(--serif); font-size: 1.5rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn.ghost { border-color: var(--line); }
  .tags { display: flex; flex-wrap: wrap; gap: 12px; font-size: 0.9rem; margin-top: 28px; }
  .tags a { color: var(--accent); text-decoration: none; }
  .pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 72px; padding-top: 24px; border-top: 1px solid var(--line); font-family: var(--serif); font-size: 1.2rem; }
  .pager a { text-decoration: none; }
  @media (max-width: 900px) { .work { grid-template-columns: 1fr; } .info { position: static; } }
</style>
