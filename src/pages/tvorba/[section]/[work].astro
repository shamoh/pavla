---
import Base from '../../../layouts/Base.astro';
import Picture from '../../../components/Picture.astro';
import Img from '../../../components/Img.astro';
import { collectionUrl, config, detailCaption, getCollection, workPinImage, workShareImage, getWorks, messages, site, statusLabel, formatSize, formatPrice, url, workUrl, workImagePath, type Work } from '../../../lib/site';
import { isOnSale, wantsMockups } from '../../../../scripts/lib/works.mjs';
import { EVENTS } from '../../../../scripts/lib/analytics.mjs';
import { pinDescription } from '../../../../scripts/lib/pinterest.mjs';
import { shareLinks } from '../../../../scripts/lib/share.mjs';
import { artworkLd, breadcrumbLd, graphLd, workPageDescription, workPageTitle } from '../../../../scripts/lib/seo.mjs';
import { defaultType, mailtoLink, workContext } from '../../../../scripts/lib/messages.mjs';

export function getStaticPaths() {
  const works = getWorks();
  return works.map((work, i) => ({ params: { section: String(work.year), work: work.key }, props: { work, prev: works[i - 1], next: works[i + 1] } }));
}
interface Props { work: Work; prev?: Work; next?: Work }
const { work, prev, next } = Astro.props;
const date = work.date.toLocaleDateString('cs-CZ', { month: 'long', year: 'numeric' });

const collection = getCollection(work.collection);
// Every shown work: another with the same title or description gets what tells them apart in <title> and the
// meta description (workPageTitle, workPageDescription), so no two pages look the same in search results.
const allWorks = getWorks();

// Everything the viewer can step through: the work itself, its details, then its mockups.
const base = workImagePath(work);
const details = (work.image.details ?? []).map((d, i) => ({ ...d, caption: detailCaption(work, d.name) || `detail ${i + 1}` }));
// Mockups only when the author asked for them (mockups: true), whether or not the work is for sale.
const mockups = wantsMockups(work) ? work.image.mockups ?? [] : [];
const mockupsHeading = isOnSale(work.status) ? 'Jak by mohl vypadat u vás' : 'Jak vypadá na zdi';
const views = [
  { label: work.title, prefix: '', image: work.image },
  ...details.map((d) => ({ label: `${work.title} · ${d.caption}`, prefix: `detail-${d.name}-`, image: d })),
  ...mockups.map((m) => ({ label: `${work.title} · ${m.label}`, prefix: `mockup-${m.scene}-`, image: m })),
].map((v) => ({
  label: v.label,
  width: v.image.width,
  height: v.image.height,
  src: url(`${base}/${v.prefix}${v.image.widths[v.image.widths.length - 1]}.jpg`),
  srcset: v.image.widths.map((w) => `${url(`${base}/${v.prefix}${w}.webp`)} ${w}w`).join(', '),
  // the surroundings of the sheet are transparent (meta_corners): a shadow along the paper, no background
  cutout: !!v.image.transparent,
}));
// Landscape mockups are stacked, portrait ones sit side by side.
const mockupsWide = mockups.every((m) => m.width >= m.height);
// For search engines: the work as a work of art by the author, and where it lies on the site.
const share = workShareImage(work);
const path = `/tvorba/${work.year}/${work.key}/`;
// A message from this page is about the work: a question, or interest in buying when it is for sale.
const message = workContext({ ...work, onSale: isOnSale(work.status) }, path);
// Without the form: an e-mail with the same subject as a message would have.
const mail = site.email && mailtoLink(site.email, defaultType(message), message);
// "Sdílet": links to share the work (Pinterest saves its pin, or the share image, with a link to this page)
const pageUrl = new URL(path, site.url).href;
const shares = shareLinks({
  url: pageUrl, media: new URL(workPinImage(work).src, site.url).href, title: work.title,
  description: [work.title, pinDescription(work, work.year, config.pinterestKeywords?.en)].filter(Boolean).join(' – '),
});
// Small line icons of the services (own drawings in the colour of the text, nothing loaded from them)
const ICONS: Record<string, string> = {
  pinterest: '<circle cx="12" cy="12" r="9.5"/><path d="M10.2 19.6l1.9-8.1M10.9 13.6c.4 1 1.3 1.5 2.4 1.5 2.1 0 3.4-2 3.4-4.4 0-2.5-2-4.3-4.6-4.3-3 0-4.8 2.1-4.8 4.4 0 .9.3 1.7.9 2.2"/>',
  facebook: '<rect x="3" y="3" width="18" height="18" rx="4"/><path d="M15.5 8.5h-1.7c-1 0-1.8.8-1.8 1.8V21M9.8 13h5"/>',
  whatsapp: '<path d="M4.5 19.5l1.2-3.6A8.2 8.2 0 1 1 8.4 18.6z"/><path d="M9.3 9.2c.3 2 2.2 4.2 4.6 4.9l1-1"/>',
  link: '<path d="M10 14a4 4 0 0 0 5.7 0l2.8-2.8a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-2.8 2.8a4 4 0 0 0 5.7 5.7l1-1"/>',
  instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r=".6" fill="currentColor"/>',
};
const icon = (name: string) => `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name]}</svg>`;
const jsonLd = graphLd(
  artworkLd(work, site, { path, image: new URL(share.src, site.url).href }),
  breadcrumbLd(site, [
    { name: 'Úvod', path: '/' },
    { name: 'Tvorba', path: '/tvorba/' },
    collection ? { name: collection.title, path: `/tvorba/kolekce/${collection.slug}/` } : { name: String(work.year), path: `/tvorba/${work.year}/` },
    { name: work.title, path },
  ]),
);
---
<Base title={workPageTitle(work, allWorks)} description={workPageDescription(work, allWorks, site)} image={share} type="article" jsonLd={jsonLd} message={message}>
  <p class="back"><a href={url('/tvorba/')} data-return data-return-focus={work.id}>← Tvorba</a> · <a href={url(`/tvorba/${work.year}/`)} data-return data-return-focus={work.id}>{work.year}</a></p>
  <article class="work">
    <a class="zoom" href={views[0].src} data-view="0" title="Zvětšit">
      <Picture work={work} sizes="(max-width: 900px) 100vw, 64vw" eager />
    </a>
    {(work.description || work.tags.length > 0) && (
      <div class="story">
        {work.description && <p class="desc">{work.description}</p>}
        {work.tags.length > 0 && (
          <p class="tags">{work.tags.map((t) => <a href={url(`/tvorba/?tag=${encodeURIComponent(t)}`)}>#{t}</a>)}</p>
        )}
      </div>
    )}
    <div class="info">
      <div class="head">
        <h1>{work.title}</h1>
        <dl>
          <dt>Technika</dt><dd>{work.technique}</dd>
          {work.support && <><dt>Podklad</dt><dd>{work.support}</dd></>}
          {work.size_cm && <><dt>Rozměr</dt><dd>{formatSize(work.size_cm)}</dd></>}
          <dt>Vzniklo</dt><dd>{date}</dd>
          {collection && <><dt>Kolekce</dt><dd><a href={collectionUrl(collection.slug)} data-return data-return-focus={work.id}>{collection.title}</a></dd></>}
        </dl>
      </div>
      {work.status !== 'not-for-sale' && (
        <div class="buy">
          <span class:list={['badge', { available: work.status === 'available' }]}>{statusLabel[work.status]}</span>
          {work.status === 'available' && work.price && <span class="price">{formatPrice(work.price)}</span>}
          {work.status === 'available' && (
            <span class="actions">
              {work.fler && <a class="btn small" href={work.fler} data-track={EVENTS.fler} data-work-id={work.id} data-work-title={work.title}>Koupit na Fleru</a>}
              {messages.mode && <button type="button" class="btn small ghost" data-message-open={defaultType(message)} title="Zeptat se na obraz">Zeptat se</button>}
              {!messages.mode && mail && <a class="btn small ghost" href={mail} data-track={EVENTS.email} data-work-id={work.id} data-work-title={work.title} title="Napsat autorce o obraze">Napsat</a>}
            </span>
          )}
        </div>
      )}
      <div class="share">
        <span class="eyebrow">Sdílet</span>
        {shares.map((l) => (
          <a class="icon" href={l.href} rel="noopener" target="_blank" title={l.label} aria-label={l.label}
            data-track={EVENTS.share} data-method={l.method} data-work-id={work.id} data-work-title={work.title} set:html={icon(l.method)} />
        ))}
        <button type="button" class="icon" data-share-link data-url={pageUrl} data-title={work.title} title="Zkopírovat odkaz" aria-label="Zkopírovat odkaz"
          data-track={EVENTS.share} data-method="copy" data-work-id={work.id} data-work-title={work.title} set:html={icon('link')} />
        <span class="muted copied" data-share-status role="status"></span>
        {work.instagram && (
          <a class="elsewhere" href={work.instagram} rel="noopener" title="Obraz na Instagramu" data-track={EVENTS.instagram} data-work-id={work.id} data-work-title={work.title}>
            <Fragment set:html={icon('instagram')} />Na Instagramu
          </a>
        )}
      </div>
      {details.length > 0 && (
        <section class="details" aria-label="Detaily obrazu">
          {details.map((d, i) => (
            <a href={views[i + 1].src} data-view={i + 1} title={`Zvětšit: ${d.caption}`}>
              <span class="thumb"><Img base={base} prefix={`detail-${d.name}-`} image={d} alt={`${work.title}: ${d.caption}`} sizes="(max-width: 900px) 33vw, 12vw" /></span>
              <span class="muted">{d.caption}</span>
            </a>
          ))}
        </section>
      )}
      {mockups.length > 0 && (
        <section class="mockups" aria-label="Jak obraz vypadá v interiéru">
          <p class="eyebrow">{mockupsHeading}</p>
          <div class:list={['mockup-grid', { wide: mockupsWide }]}>
            {mockups.map((m, i) => (
              <a href={views[1 + details.length + i].src} data-view={1 + details.length + i} title={`Zvětšit: ${m.label}`}>
                <Img base={base} prefix={`mockup-${m.scene}-`} image={m} alt={`${work.title} v interiéru: ${m.label}`} sizes="(max-width: 900px) 100vw, 30vw" />
                <span class="muted">{m.label} · skutečná velikost {formatSize(work.size_cm)}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
  <dialog class="viewer" id="viewer" aria-label="Prohlížení obrázků" data-views={JSON.stringify(views)}>
    <figure>
      <img id="viewer-img" alt="" />
      <figcaption><span id="viewer-label"></span> <span class="muted" id="viewer-count"></span></figcaption>
    </figure>
    {views.length > 1 && (
      <>
        <button type="button" class="nav prev" data-step="-1" aria-label="Předchozí">‹</button>
        <button type="button" class="nav next" data-step="1" aria-label="Další">›</button>
      </>
    )}
    <button type="button" class="close" aria-label="Zavřít">×</button>
  </dialog>
  <nav class="pager" aria-label="Další díla">
    {prev ? <a href={workUrl(prev)}>← {prev.title}</a> : <span />}
    {next && <a href={workUrl(next)}>{next.title} →</a>}
  </nav>
</Base>
<script>
  import { applyShareButtons } from '../../../lib/share-button';
  applyShareButtons();
</script>
<script>
  // Viewer: a dialog (not fullscreen) that steps through the work and its mockups.
  // Without JavaScript the links simply open the largest image.
  type View = { label: string; src: string; srcset: string; width: number; height: number; cutout: boolean };
  const dialog = document.getElementById('viewer') as HTMLDialogElement;
  const img = document.getElementById('viewer-img') as HTMLImageElement;
  const label = document.getElementById('viewer-label')!;
  const count = document.getElementById('viewer-count')!;
  const views: View[] = JSON.parse(dialog.dataset.views!);
  let current = 0;

  function show(i: number) {
    current = (i + views.length) % views.length;
    const v = views[current];
    img.srcset = v.srcset;
    img.sizes = `min(92vw, ${Math.round((v.width / v.height) * 80)}vh)`;
    img.src = v.src;
    img.width = v.width;
    img.height = v.height;
    img.alt = v.label;
    img.classList.toggle('cutout', v.cutout);
    label.textContent = v.label;
    count.textContent = views.length > 1 ? `${current + 1} / ${views.length}` : '';
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-view]').forEach((a) =>
    a.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return; // let "open in new tab" work
      e.preventDefault();
      show(Number(a.dataset.view));
      dialog.showModal();
    }),
  );
  dialog.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => show(current + Number(b.dataset.step))));
  dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
  // A click on the backdrop (outside the figure) closes the viewer.
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(current + 1);
    if (e.key === 'ArrowLeft') show(current - 1);
  });
  // Swipe on touch screens.
  let startX: number | null = null;
  dialog.addEventListener('pointerdown', (e) => { startX = e.clientX; });
  dialog.addEventListener('pointerup', (e) => {
    if (startX !== null && Math.abs(e.clientX - startX) > 50) show(current + (e.clientX < startX ? 1 : -1));
    startX = null;
  });
</script>
<style>
  .back { margin: -12px 0 24px; font-size: 0.9rem; }
  .back a { text-decoration: none; color: var(--ink-soft); }
  /* The picture with its story (description, tags) under it on the left, everything else on the right; a narrow
     screen puts them one under another: picture, title and facts, story, price, sharing, details, mockups. */
  .work {
    display: grid; grid-template-columns: 1.8fr 1fr; grid-template-rows: auto 1fr;
    column-gap: clamp(24px, 5vw, 64px); row-gap: 8px; align-items: start;
  }
  .zoom { grid-column: 1; grid-row: 1; }
  .story { grid-column: 1; grid-row: 2; max-width: 68ch; }
  .info { grid-column: 2; grid-row: 1 / span 2; }
  .zoom { display: block; cursor: zoom-in; }
  .zoom :global(picture) { box-shadow: var(--shadow-deep); }
  .zoom :global(picture.cutout) { box-shadow: none; filter: var(--drop-deep); }
  .info h1 { margin-top: 0; }
  dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 20px; font-size: 0.93rem; margin: 0 0 20px; }
  dt { color: var(--ink-soft); }
  dd { margin: 0; }
  .desc { white-space: pre-line; }
  .details { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 20px 0; }
  .details a { display: flex; flex-direction: column; gap: 6px; text-decoration: none; font-size: 0.8rem; line-height: 1.3; cursor: zoom-in; }
  .details .thumb { display: block; aspect-ratio: 1; overflow: hidden; }
  .details :global(picture), .details :global(img) { width: 100%; height: 100%; }
  .details :global(img) { object-fit: cover; }
  .buy { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; margin: 22px 0 0; }
  .price { font-family: var(--serif); font-size: 1.5rem; line-height: 1; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-left: auto; }
  .btn.small { padding: 7px 16px; }
  .btn.ghost { border-color: var(--line); }
  button.btn { background: transparent; color: var(--ink); font: inherit; font-size: 0.92rem; cursor: pointer; }
  button.btn:hover { background: var(--ink); color: var(--paper); }
  .share { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin: 20px 0 0; font-size: 0.88rem; }
  .share .eyebrow { margin-right: 4px; }
  .share .icon {
    display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; padding: 0;
    border: 1px solid var(--line); border-radius: 50%; background: transparent; color: var(--ink-soft); cursor: pointer;
    transition: color .15s, border-color .15s;
  }
  .share .icon:hover { color: var(--accent); border-color: var(--accent); }
  .share .copied:empty { display: none; }
  .share .elsewhere { display: inline-flex; align-items: center; gap: 6px; margin-left: auto; color: var(--ink-soft); text-decoration: none; }
  .share .elsewhere:hover { color: var(--accent); }
  .story .desc { margin: 18px 0 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 12px; font-size: 0.9rem; margin: 12px 0 0; }
  .tags a { color: var(--accent); text-decoration: none; }
  .mockups { margin-top: 36px; padding-top: 20px; border-top: 1px solid var(--line); }
  .mockup-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .mockup-grid.wide { grid-template-columns: 1fr; }
  .mockup-grid a { display: flex; flex-direction: column; gap: 6px; text-decoration: none; font-size: 0.82rem; cursor: zoom-in; }
  .viewer { border: 0; padding: 0; background: transparent; max-width: 96vw; max-height: 96vh; overflow: visible; }
  .viewer::backdrop { background: rgba(30, 26, 22, .82); }
  .viewer figure { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .viewer img { display: block; max-width: 92vw; max-height: 82vh; width: auto; height: auto; box-shadow: 0 24px 64px rgba(0,0,0,.45); background: var(--paper-2); }
  .viewer img.cutout { box-shadow: none; background: none; filter: drop-shadow(0 18px 28px rgba(0,0,0,.45)); }
  .viewer figcaption { color: #f3eee6; font-size: 0.9rem; text-align: center; }
  .viewer figcaption .muted { color: #bdb3a6; margin-left: 8px; }
  .viewer button { position: fixed; background: rgba(0,0,0,.35); color: #fff; border: 0; cursor: pointer; font: 300 2.4rem/1 var(--sans); width: 52px; height: 52px; border-radius: 50%; }
  .viewer button:hover { background: rgba(0,0,0,.6); }
  .viewer .prev { left: 16px; top: 50%; transform: translateY(-50%); }
  .viewer .next { right: 16px; top: 50%; transform: translateY(-50%); }
  .viewer .close { right: 16px; top: 16px; font-size: 2rem; }
  .pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 72px; padding-top: 24px; border-top: 1px solid var(--line); font-family: var(--serif); font-size: 1.2rem; }
  .pager a { text-decoration: none; }
  @media (max-width: 900px) {
    .work { grid-template-columns: 1fr; grid-template-rows: none; }
    .info { display: contents; }
    .zoom, .story, .info > * { grid-column: 1; grid-row: auto; }
    .zoom { order: 1; } .head { order: 2; } .story { order: 3; } .buy { order: 4; } .share { order: 5; } .details { order: 6; } .mockups { order: 7; }
    .head h1 { margin-top: 16px; }
    .story .desc { margin-top: 0; }
  }
</style>
