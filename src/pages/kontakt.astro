---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site } from '../lib/site';
import { breadcrumbLd, graphLd } from '../../scripts/lib/seo.mjs';

const description = 'Zaujal vás obraz, nebo jen chcete pozdravit? Napište mi – a když se vám některý obraz zalíbí, domluvíme se.';
// For search engines: the contact page of the author.
const jsonLd = graphLd(
  { '@type': 'ContactPage', '@id': new URL('/kontakt/', site.url).href, url: new URL('/kontakt/', site.url).href, name: `Kontakt – ${site.author}`, inLanguage: 'cs', about: { '@id': new URL('/#autorka', site.url).href } },
  breadcrumbLd(site, [{ name: 'Úvod', path: '/' }, { name: 'Kontakt', path: '/kontakt/' }]),
);
---
<Base title="Kontakt" description={description} jsonLd={jsonLd}>
  <div class="contact-page">
    <div>
      <h1>Kontakt</h1>
      <p>Zaujal vás obraz nebo jen chcete pozdravit?</p>
      <ul class="contact">
        {site.email && <li><span class="eyebrow">E-mail</span><a href={`mailto:${site.email}`}>{site.email}</a></li>}
        {site.instagram && <li><span class="eyebrow">Instagram</span><a href={`https://www.instagram.com/${site.instagram}/`} rel="me">@{site.instagram}</a></li>}
        {site.fler && <li><span class="eyebrow">Obchůdek</span><a href={site.fler}>Fler</a></li>}
      </ul>
    </div>
    <!-- Landscape 4:3 crop around the photo's focus, so it does not tower over the short text next to it. -->
    <Photo name="kontakt" sizes="(max-width: 800px) 100vw, 40vw" class="contact-photo" aspect="4 / 3" />
  </div>
</Base>
<style>
  .contact-page { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 6vw, 96px); align-items: start; }
  .contact-page:not(:has(:global(.contact-photo))) { grid-template-columns: 1fr; }
  @media (max-width: 800px) { .contact-page { grid-template-columns: 1fr; } }
  .contact { list-style: none; padding: 0; margin: 40px 0 0; display: grid; gap: 28px; }
  .contact li { display: flex; flex-direction: column; gap: 4px; }
  .contact a { font-family: var(--serif); font-size: 1.7rem; text-decoration: none; }
</style>
