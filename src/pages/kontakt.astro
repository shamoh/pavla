---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import MessageForm from '../components/MessageForm.astro';
import NameShades from '../components/NameShades.astro';
import { getPage, hasFeaturedWorks, hasWorksOnSale, messages, site, url } from '../lib/site';
import { featuredShowPath, saleShowPath } from '../../scripts/lib/cinema.mjs';
import { breadcrumbLd, graphLd } from '../../scripts/lib/seo.mjs';
import { EVENTS } from '../../scripts/lib/analytics.mjs';
import { mailtoLink } from '../../scripts/lib/messages.mjs';
import { pinterestHandle, pinterestProfileLink } from '../../scripts/lib/pinterest.mjs';

// Where to find me: e-mail, profiles and the shop (the ones set in site.config.yaml), in this order; each shows its
// address or account (Pinterest as @<user name> like Instagram; given name, surname and the rest in three shades,
// NameShades) and says in its tooltip where it leads.
const pinterestUser = pinterestHandle(site.pinterest);
const links = [
  site.email && { label: 'E-mail', href: mailtoLink(site.email, 'greeting', null), text: site.email, title: 'Napsat mi e-mail', track: EVENTS.email },
  site.instagram && { label: 'Instagram', href: `https://www.instagram.com/${site.instagram}/`, text: `@${site.instagram}`, title: 'Můj profil na Instagramu', rel: 'me' },
  site.pinterest && {
    label: 'Pinterest', href: pinterestProfileLink(site.pinterest), text: pinterestUser ? `@${pinterestUser}` : 'Pavla na Pinterestu',
    title: 'Moje obrazy na Pinterestu', rel: 'me',
  },
  site.fler && { label: 'Obchůdek', href: site.fler, text: 'Fler', title: 'Můj obchůdek na Fleru' },
].filter(Boolean) as { label: string; href: string; text: string; title: string; rel?: string; track?: string }[];
// Then "Promítnout": the works shown one after another (the cinema of the gallery), each show while it has works.
const SHOW_TITLE = 'jeden po druhém přes celou obrazovku';
const shows = [
  hasWorksOnSale() && { text: 'Obrazy na prodej', href: url(saleShowPath('contact')), title: `Obrazy na prodej ${SHOW_TITLE}` },
  hasFeaturedWorks() && { text: 'Moje nejmilejší', href: url(featuredShowPath('contact')), title: `Obrazy z mého výběru ${SHOW_TITLE}` },
].filter(Boolean) as { text: string; href: string; title: string }[];
// The texts are in stranky/kontakt.yaml of the content repository.
const { description, paragraphs, locationLabel } = getPage('kontakt')!;
// For search engines: the contact page of the author.
const jsonLd = graphLd(
  { '@type': 'ContactPage', '@id': new URL('/kontakt/', site.url).href, url: new URL('/kontakt/', site.url).href, name: `Kontakt – ${site.author}`, inLanguage: 'cs', about: { '@id': new URL('/#autorka', site.url).href } },
  breadcrumbLd(site, [{ name: 'Úvod', path: '/' }, { name: 'Kontakt', path: '/kontakt/' }]),
);
---
<Base title="Kontakt" description={description} jsonLd={jsonLd} messagePanel={false}>
  <div class="contact-page">
    <div>
      <h1>Kontakt</h1>
      {paragraphs.map((p) => <p set:html={p} />)}
      {messages.mode && <MessageForm variant="inline" />}
      {!messages.mode && (
        <ul class="contact">
          {links.map((l) => <li><span class="eyebrow">{l.label}</span><a href={l.href} title={l.title} rel={l.rel} data-track={l.track}><NameShades text={l.text} /></a></li>)}
          {shows.length > 0 && <li><span class="eyebrow">Promítnout</span><span class="shows">{shows.map((s) => <a href={s.href} title={s.title}>{s.text}</a>)}</span></li>}
          {site.location && <li><span class="eyebrow">{locationLabel}</span><span class="value">{site.location}</span></li>}
        </ul>
      )}
    </div>
    <!-- Landscape 3:2 crop around the photo's focus (a 3:2 photo stays whole), so it does not tower over the short text next to it;
         its white paper edge melts into the paper of the page. -->
    <Photo name="kontakt" sizes="(max-width: 800px) 100vw, 40vw" class="contact-photo" aspect="3 / 2" blendEdge={10} />
    <!-- Under the form and the photo, across the whole width: where to find me on the left, where I live on the right -->
    {messages.mode && (
      <div class="contact-row">
        <ul class="contact compact">
          {links.map((l) => <li><span class="eyebrow">{l.label}</span><a href={l.href} title={l.title} rel={l.rel} data-track={l.track}><NameShades text={l.text} /></a></li>)}
          {shows.length > 0 && <li><span class="eyebrow">Promítnout</span><span class="shows">{shows.map((s) => <a href={s.href} title={s.title}>{s.text}</a>)}</span></li>}
        </ul>
        {site.location && <p class="where"><span class="eyebrow">{locationLabel}</span><span class="value">{site.location}</span></p>}
      </div>
    )}
  </div>
</Base>
<style>
  .contact-page { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 6vw, 96px); align-items: start; }
  .contact-page:not(:has(:global(.contact-photo))) { grid-template-columns: 1fr; }
  @media (max-width: 800px) { .contact-page { grid-template-columns: 1fr; } }
  .contact { list-style: none; padding: 0; margin: 40px 0 0; display: grid; gap: 28px; }
  .contact li { display: flex; flex-direction: column; gap: 4px; }
  .contact-page :global(.msg-form) { margin-top: 32px; max-width: 34rem; }
  /* Under the form and the photo the addresses are one quiet row across the page, so they do not outshout the form;
     where I live (a different kind of fact) sits apart on the right. */
  .contact-row {
    grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 14px 32px;
    padding-top: 24px; border-top: 1px solid var(--line);
  }
  .contact.compact { margin: 0; display: flex; flex-wrap: wrap; gap: 14px 40px; }
  .where { margin: 0; display: flex; flex-direction: column; gap: 4px; text-align: right; }
  @media (max-width: 800px) { .where { text-align: left; } }
  .contact a, .contact .value, .where .value { font-family: var(--serif); font-size: 1.7rem; text-decoration: none; }
  .contact.compact a, .contact-row .value { font-size: 1.25rem; }
  /* The shows side by side under one "Promítnout", parted by a quiet dot (wrapping on a narrow screen). */
  .shows { display: flex; flex-wrap: wrap; gap: 0 0.5em; }
  .shows a + a::before { content: '·'; margin-right: 0.5em; color: var(--ink-soft); }
</style>
