---
// Cover of a collection, always cropped to 3:2 around the collection's `focus`:
// its own photo, a detail photo of a work (`cover: <id>#<detail>`), a whole work (`cover: <id>`), or else one of
// the newest works of the author's selection (featured) at random per visit (scripts/lib/random-pick.mjs).
import Img from './Img.astro';
import { type Collection, type Work, workImagePath, workUrl } from '../lib/site';
import { randomPickScript } from '../../scripts/lib/random-pick.mjs';

// `link`: each work shown links to its page (the collection page; the overview links to the collection instead).
interface Props { collection: Collection; sizes: string; eager?: boolean; link?: boolean }
const { collection: c, sizes, eager, link } = Astro.props;
const [fx, fy] = c.focus;
const whole = (w: Work) => ({ base: workImagePath(w), prefix: '', set: w.image, alt: `${w.title} — ${w.technique}`, id: w.id, href: workUrl(w) });
const images = c.cover
  ? [{ base: `/collections/${c.slug}`, prefix: '', set: c.cover, alt: c.cover.alt || c.title, id: c.slug, href: undefined }]
  : c.coverDetail
    ? [{ base: workImagePath(c.coverWork), prefix: `detail-${c.coverDetail.name}-`, set: c.coverDetail, alt: `${c.coverWork.title}, detail`, id: c.coverWork.id, href: workUrl(c.coverWork) }]
    : c.coverWorks.map(whole);
// Link target of each image: its work on the collection page, none in the overview (the whole item links there).
const hrefs = images.map((image) => (link ? image.href : undefined));
---
<div class="collection-cover" style={`--focus: ${fx}% ${fy}%`}>
  {images.map((image, i) =>
    hrefs[i] ? (
      <a class="pick" href={hrefs[i]} data-pick data-id={image.id} hidden={i > 0}>
        <Img base={image.base} prefix={image.prefix} image={image.set} alt={image.alt} sizes={sizes} eager={eager && i === 0} />
      </a>
    ) : (
      <div class="pick" data-pick data-id={image.id} hidden={i > 0}>
        <Img base={image.base} prefix={image.prefix} image={image.set} alt={image.alt} sizes={sizes} eager={eager && i === 0} />
      </div>
    ),
  )}
</div>
{images.length > 1 && <script is:inline set:html={randomPickScript} />}
<style>
  .collection-cover { aspect-ratio: 3 / 2; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,.06), 0 12px 32px -16px rgba(0,0,0,.25); }
  .collection-cover .pick { display: block; height: 100%; }
  .collection-cover :global(picture) { height: 100%; }
  .collection-cover :global(img) { height: 100%; object-fit: cover; object-position: var(--focus); }
</style>
