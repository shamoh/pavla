---
// The search field next to the heading of a listing (?q=, scripts/lib/search.mjs): the gallery /tvorba/ searches
// the titles of works, the collections overview the titles of collections. The listing's script reads and writes it
// (by `id`); it filters as the visitor types. Next to the heading on a computer, under it on a phone.
// `hint`: a note under the field, hidden until the listing's script shows it (`<id>-hint`; the gallery: "Enter otevře
// obraz" while the field holds exactly the id of a shown work); out of the flow, so it never moves the page.
import { SEARCH_MAX } from '../../scripts/lib/search.mjs';
interface Props { id: string; label: string; placeholder: string; hint?: string }
const { id, label, placeholder, hint } = Astro.props;
---
<span class="search">
  <input type="search" id={id} name="q" aria-label={label} placeholder={placeholder}
    maxlength={SEARCH_MAX} autocomplete="off" spellcheck="false" enterkeyhint="search"
    aria-describedby={hint ? `${id}-hint` : undefined} />
  {hint && <span class="hint" id={`${id}-hint`} aria-live="polite" hidden>{hint}</span>}
</span>

<style>
  .search { display: inline-block; position: relative; width: min(100%, 18rem); }
  input {
    font: inherit; font-size: 0.95rem; color: var(--ink); background: var(--paper);
    border: 1px solid var(--line); border-radius: 99px; padding: 7px 16px; width: 100%;
  }
  input::placeholder { color: var(--ink-soft); opacity: 1; }
  input:hover { border-color: var(--ink-soft); }
  input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .hint {
    position: absolute; top: calc(100% + 6px); left: 12px; z-index: 2; white-space: nowrap;
    font-size: 0.8rem; color: var(--ink-soft); background: var(--paper); padding: 1px 6px; border-radius: 4px;
  }
  .hint[hidden] { display: none; }
</style>
