---
// The search field next to the heading of a listing (?q=, scripts/lib/search.mjs): the gallery /tvorba/ searches
// the titles of works, the collections overview the titles of collections. The listing's script reads and writes it
// (by `id`); it filters as the visitor types. Next to the heading on a computer, under it on a phone.
import { SEARCH_MAX } from '../../scripts/lib/search.mjs';
interface Props { id: string; label: string; placeholder: string }
const { id, label, placeholder } = Astro.props;
---
<input class="search" type="search" id={id} name="q" aria-label={label} placeholder={placeholder}
  maxlength={SEARCH_MAX} autocomplete="off" spellcheck="false" enterkeyhint="search" />

<style>
  .search {
    font: inherit; font-size: 0.95rem; color: var(--ink); background: var(--paper);
    border: 1px solid var(--line); border-radius: 99px; padding: 7px 16px; width: min(100%, 18rem);
  }
  .search::placeholder { color: var(--ink-soft); opacity: 1; }
  .search:hover { border-color: var(--ink-soft); }
  .search:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
