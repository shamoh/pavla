---
import WorkGrid from './WorkGrid.astro';
import Pager from './Pager.astro';
import { type Work, config, getCollections, getYears, url } from '../lib/site';
import { DEFAULT_VIEW, NO_COLLECTION, NO_COLLECTION_TITLE, TILE_SIZE_STORAGE_KEY, VIEW_STORAGE_KEY, czechOrder, statusOptions, yearFilterOptions } from '../../scripts/lib/gallery-filter.mjs';
import { viewScript, viewSetup } from '../../scripts/lib/view-layout.mjs';
import { overviewLink, yearCounts, yearOptions } from '../../scripts/lib/collection-filter.mjs';

interface Props { works: Work[]; year?: number; collection?: string }
// `year` set: a year page (/tvorba/2026/), the year filter is replaced by links.
// `collection` set: a collection page, which shows one collection and has no collection filter.
const { works, year, collection } = Astro.props;
const count = (vals: string[]) => {
  const m = new Map<string, number>();
  vals.forEach((v) => m.set(v, (m.get(v) ?? 0) + 1));
  return [...m.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'cs'));
};
// Tag chips in Czech alphabetical order: easy to find a known one, and a new work never reorders them.
const tags = count(works.flatMap((w) => w.tags)).sort((a, b) => a[0].localeCompare(b[0], 'cs'));
// Techniques in Czech alphabetical order, like the collections.
const techniques = czechOrder(count(works.map((w) => w.technique)), ([t]) => t);
// Collections in Czech alphabetical order (easy to find a known one), each with its works on this page;
// the collection filter is a combobox over this select (src/lib/combobox.ts).
const inPage = new Map(count(works.flatMap((w) => (w.collection ? [w.collection] : []))));
const collections = czechOrder(getCollections()).filter((c) => inPage.has(c.slug)).map((c) => ({ slug: c.slug, n: inPage.get(c.slug)!, title: c.title }));
// "žádná" right after "vše": the works in no collection (?collection=none), when some are.
const uncollected = works.filter((w) => !w.collection).length;
// Every status option with some works; the browser greys the filter out while none of them narrows (facetDisplay).
const statuses = statusOptions(works.map((w) => w.status));
// The author's selection (featured): a switch, greyed out while it changes nothing (all shown works or none).
const featuredCount = works.filter((w) => w.featured).length;
const years = getYears();
// Year options: every year of the site in the gallery; in a collection only the years of its works with counts,
// greyed out while all shown works are from one year.
const yearChoices = collection
  ? yearFilterOptions(works.map((w) => w.year)).map((o) => ({ value: o.value, label: `${o.value} (${o.count})` }))
  : years.map((y) => ({ value: String(y), label: String(y) }));
// "Kolekce" next to the years: on a year page the overview filtered to that year, when it offers it.
const allCollections = getCollections();
const collectionYears = yearOptions(allCollections.map((c) => yearCounts(c.works).map(([y]) => y))).map((o) => o.year);
const collectionsHref = overviewLink(url('/tvorba/kolekce/'), year, collectionYears);
// Page sizes the visitor can pick (the first is the default); the rest of the filtered list is on further
// pages (?page=2), hidden cards load no images.
const pageSizes: number[] = config.gallery?.pageSizes ?? [12, 24, 48];
// The tiles view has page sizes of its own (more small pictures on a page); the script switches between them.
const tilePageSizes: number[] = config.gallery?.tilePageSizes ?? [36, 72, 144];
// The view (big pictures by default): a link with the view, the tile size, the page or the page size decides, otherwise
// the memory; the inline script after the grid (viewScript) shows it before the page is painted.
const setup = viewSetup({ defaultView: DEFAULT_VIEW, linkKeys: ['view', 'tile', 'page', 'perPage'], keys: { view: VIEW_STORAGE_KEY, tile: TILE_SIZE_STORAGE_KEY } });
---
{!collection && (
  <nav class="years" id="years" aria-label="Roky">
    <a href={url('/tvorba/')} aria-current={year ? undefined : 'page'}>Vše</a>
    {years.map((y) => <a href={url(`/tvorba/${y}/`)} data-year-item={y} aria-current={y === year ? 'page' : undefined}>{y}</a>)}
    {allCollections.length > 0 && <a class="to-collections" href={collectionsHref}>Kolekce</a>}
  </nav>
)}

<div class="filter-bar" id="filter-bar" inert>
  <div class="filter-bar-inner">
    <span class="eyebrow">Filtry</span>
    <span class="bar-chips" id="bar-chips" role="group" aria-label="Vybrané filtry"></span>
    <button type="button" class="bar-reset" data-filters-reset hidden>Zrušit vše</button>
    <span class="bar-count" id="bar-count"></span>
    <button type="button" class="filter-toggle" id="filter-toggle" aria-expanded="false" aria-controls="filters">Upravit</button>
  </div>
</div>

<div class="filters-slot" id="filters-slot">
<form class="filters" id="filters" aria-label="Filtrovat díla">
  <div class="selects">
    <label>Technika
      <select name="technique"><option value="">vše</option>{techniques.map(([t, n]) => <option value={t} data-label={t}>{t} ({n})</option>)}</select>
    </label>
    {!year && yearChoices.length > 0 && (
      <label>Rok
        <select name="year"><option value="">vše</option>{yearChoices.map((o) => <option value={o.value} data-label={o.value}>{o.label}</option>)}</select>
      </label>
    )}
    {!collection && allCollections.length > 0 && (
      <label>Kolekce
        <select name="collection"><option value="">vše</option>{uncollected > 0 && <option value={NO_COLLECTION} data-label="žádná" data-chip={NO_COLLECTION_TITLE.toLowerCase()}>žádná ({uncollected})</option>}{collections.map((c) => <option value={c.slug} data-label={c.title}>{c.title} ({c.n})</option>)}</select>
      </label>
    )}
    {statuses.length > 0 && (
      <label>Stav
        <select name="status">
          <option value="">vše</option>
          {statuses.map((o) => <option value={o.value} data-label={o.label}>{o.label} ({o.count})</option>)}
        </select>
      </label>
    )}
    {works.length > 0 && (
      <label class="switch" title="Výběr autorky: obrazy, které sama doporučuji"><input type="checkbox" name="featured" value="1" /> <span>Doporučené (<span data-featured-count>{featuredCount}</span>)</span></label>
    )}
    <span class="count-group">
      <span class="muted" id="count" aria-live="polite">{works.length} děl</span>
      <button type="button" class="reset-link" data-filters-reset hidden><span aria-hidden="true">×</span> Zrušit filtry</button>
    </span>
  </div>
  <!-- The selects first (one line on a computer), the tag chips under them. -->
  <div class="chips" id="chips" role="group" aria-label="Témata (lze vybrat víc najednou)">
    <button type="button" data-filter="tag" data-value="" aria-pressed="true">Vše</button>
    {tags.map(([t, n]) => <button type="button" data-filter="tag" data-value={t} aria-pressed="false">#{t} <small>{n}</small></button>)}
  </div>
  <div class="filters-actions">
    <button type="button" class="filters-reset" data-filters-reset hidden>Zrušit filtry</button>
    <button type="button" class="filters-done" id="filters-done">Hotovo</button>
  </div>
</form>
</div>

<WorkGrid works={works} eager={3} id="grid" data-page-sizes={JSON.stringify({ grid: pageSizes, tiles: tilePageSizes })} data-view={JSON.stringify(setup)} />
<script is:inline set:html={viewScript} />
<p class="muted empty" id="empty" hidden>Tomuhle výběru nic neodpovídá.</p>
<Pager pageSizes={pageSizes} total={works.length} views />

<script>
  // Every filter and the page are written to the URL right away (?tag=krajina&status=unsold&page=2), so the
  // current selection can be copied and shared as a link and opens with the same works.
  // Tag chips toggle: each picked tag narrows the works further (?tag=krajina&tag=voda = both), "Vše" unpicks them
  // all. After every change only the chips that would narrow the shown works without emptying them stay
  // (tagChoices), with their counts among the shown works; picked ones always stay. Without JavaScript the chips
  // do nothing and every work is shown.
  // The selects (technique, year, collection, status) and the author's selection switch work the same way: after every
  // change each option shows how many works it would give with the other filters, and only options that narrow
  // the works without emptying them are left in the select (facetChoices; the picked one always stays). A filter
  // with no such option left is hidden until another change brings one back.
  // Paging happens here too: the filtered list is split into pages, cards of other pages are hidden
  // (hidden cards load no images). Without JavaScript every work is shown.
  import {
    ALL_PAGES, DEFAULT_VIEW, FEATURED_ON, TILE_SIZE_STORAGE_KEY, stepTileSize, tileSizeToRemember, NO_COLLECTION, VIEW_STORAGE_KEY, facetChoices, pageSizeStorageKey, viewPageSizes, withView, facetDisplay, matchesFilters, pageAfterFilterChange, pageSizeOf, pageSizeToRemember, paginate,
    rememberedPageSize, stateFromForm, stateFromParams, stateToParams, tagChoices, toggleTag, viewToRemember, withPageSize,
  } from '../../scripts/lib/gallery-filter.mjs';
  import { EVENTS, filterEventParams, trackEvent, viewEventParams } from '../../scripts/lib/analytics.mjs';
  import { rememberListing, revealReturned } from '../lib/page-return';
  import { fitYearRow } from '../lib/year-row';
  import { pagerTarget, renderPager } from '../lib/pager';
  import { balanceGrid, gridCards, showViewOf, viewOf } from '../../scripts/lib/view-layout.mjs';
  import { exactId, normalizeQuery } from '../../scripts/lib/search.mjs';
  import { selectCombobox } from '../lib/combobox';
  import { BAR_START, activeFilters, filteredCount, scrollBar, withoutFilter, withoutFilters, worksCount } from '../../scripts/lib/filter-bar.mjs';

  // The year links stay on one line, older years behind "2017–2003 ▾" (src/lib/year-row.ts).
  const yearRow = document.getElementById('years');
  if (yearRow) fitYearRow(yearRow);
  const form = document.getElementById('filters') as HTMLFormElement;
  const grid = document.getElementById('grid') as HTMLElement & { viewSetup?: any; viewState?: { view: string; tile: string } };
  // The cards in their order (the columns of the layout reorder them in the page, balanceGrid).
  const cards = gridCards(grid) as HTMLAnchorElement[];
  const chipGroup = document.getElementById('chips')!;
  const chips = [...form.querySelectorAll<HTMLButtonElement>('[data-filter="tag"]')];
  const tagChips = chips.filter((b) => b.dataset.value);
  const tagNames = tagChips.map((b) => b.dataset.value!);
  const tagsOf = (card: HTMLElement) => card.dataset.tags!.split('|').filter(Boolean);
  const workOf = (c: HTMLElement) => {
    const d = c.dataset;
    return { search: d.search!, tags: tagsOf(c), technique: d.technique!, year: d.year!, collection: d.collection!, status: d.status!, featured: d.featured === '1' };
  };
  const works = cards.map(workOf);
  // The search in titles and descriptions next to the heading (SearchField.astro, on every page with a gallery).
  const searchInput = document.getElementById('works-search') as HTMLInputElement | null;
  // "Enter otevře obraz" under the field: shown exactly when Enter would open a work (the same exactId).
  const searchHint = document.getElementById('works-search-hint');
  const cardIds = cards.map((c) => c.dataset.id!);
  const syncSearchHint = () => {
    if (searchHint) searchHint.hidden = !(searchInput && document.activeElement === searchInput && exactId(searchInput.value, cardIds));
  };
  const countEl = document.getElementById('count')!;
  // "Zrušit filtry" next to the count, in the open panel and "Zrušit vše" in the bar: all filters off (withoutFilters)
  const resets = [...document.querySelectorAll<HTMLButtonElement>('[data-filters-reset]')];
  const emptyEl = document.getElementById('empty')!;
  const pager = document.getElementById('pager')!;
  // Page sizes of each view (big pictures, tiles); `pageSizes` = those of the current view.
  const sizes: { grid: number[]; tiles: number[] } = JSON.parse(grid.dataset.pageSizes!);
  const perPageLabel = document.getElementById('per-page');
  const perPageSelect = perPageLabel?.querySelector('select') ?? null;
  const featuredBox = form.elements.namedItem('featured') as HTMLInputElement | null;
  const select = (name: string) => form.elements.namedItem(name) as HTMLSelectElement | null;
  // Filters without a select on this page (year on a year page, collection on a collection page) are off.
  const selects = (['technique', 'year', 'collection', 'status'] as const).filter((k) => select(k));
  // Every option of each select as built ("vše" first); apply() puts back only the offered ones (removing them
  // instead of hiding, which Safari on iOS ignores).
  const allOptions = Object.fromEntries(selects.map((k) => [k, [...select(k)!.options]]));
  const featuredCount = form.querySelector<HTMLElement>('[data-featured-count]');
  // The collection filter as a combobox over its select ("vše" and "žádná" stay on top while typing).
  const collectionSelect = select('collection');
  const collectionCombo = collectionSelect
    ? selectCombobox(collectionSelect, { keep: collectionSelect.querySelector(`option[value="${NO_COLLECTION}"]`) ? 2 : 1, placeholder: 'vše' })
    : null;
  const FEATURED_TITLE = featuredBox?.closest('label')?.title ?? '';
  const params = new URLSearchParams(location.search);
  // What the visitor picked earlier is remembered in this browser: the view (big pictures or tiles) and the page
  // size of each view (not "Zobrazit vše", that one is one-off). It never overrides a link (?view, ?perPage, ?page),
  // and apply() writes it to the URL, so a copied link still shows the same works. Storage may be blocked (private
  // mode), then nothing is remembered.
  const stored = (key: string) => ({
    get: () => { try { return localStorage.getItem(key); } catch { return null; } },
    set: (v: string | null) => {
      try { v === null ? localStorage.removeItem(key) : localStorage.setItem(key, v); } catch { /* ignore */ }
    },
  });
  const viewStorage = stored(VIEW_STORAGE_KEY);
  const viewButtons = [...document.querySelectorAll<HTMLButtonElement>('#view button[data-view]')];
  const sizeStorage = (view: string) => stored(pageSizeStorageKey(view));
  // The view and tile size as the inline script after the grid showed them (viewOf: a link decides, then the memory).
  const tileStorage = stored(TILE_SIZE_STORAGE_KEY);
  const setup = grid.viewSetup ?? JSON.parse(grid.dataset.view!);
  const shown = grid.viewState ?? viewOf(location.search, viewStorage.get(), tileStorage.get(), setup);
  const view = shown.view;
  let pageSizes = viewPageSizes(view, sizes);
  let state = { ...stateFromParams(params, pageSizes), view };
  state.tile = shown.tile;
  const tileSteps = [...document.querySelectorAll<HTMLButtonElement>('#tile-size button[data-tile-step]')];
  if (perPageSelect) state.perPage = rememberedPageSize(params, sizeStorage(view).get(), pageSizes) ?? state.perPage;
  /** The options of "Na stránku": the page sizes of the current view. */
  function fillPageSizes() {
    if (!perPageSelect) return;
    perPageSelect.replaceChildren(...pageSizes.map((n) => new Option(String(n), String(n))));
  }
  fillPageSizes();
  for (const k of ['year', 'collection'] as const) if (!select(k)) state[k] = '';
  // A year or status option not offered here (nothing behind it, e.g. an old link) is off, like a missing filter.
  for (const k of ['year', 'status'] as const) {
    const s = select(k);
    if (!s || ![...s.options].some((o) => o.value === state[k])) state[k] = '';
  }
  if (!featuredBox) state.featured = '';
  if (!searchInput) state.q = '';
  // A tag without a chip here (no work of this page has it, e.g. an old link) is off.
  state.tag = state.tag.filter((t) => tagNames.includes(t));


  const href = (page: number | typeof ALL_PAGES) => {
    const p = stateToParams({ ...state, page });
    return p.size ? `?${p}` : location.pathname;
  };

  /** Shows the works of the current state and writes it to the URL; returns how many works match. */
  function apply() {
    const matching = cards.filter((_, i) => matchesFilters(works[i], state));
    const { page, pages, start, end } = paginate(matching.length, state.page, pageSizeOf(state, pageSizes));
    state.page = page;
    showViewOf(grid, setup, state);
    const visible = new Set(matching.slice(start, end));
    for (const c of cards) c.hidden = !visible.has(c);
    // The shown cards in columns of about the same height.
    balanceGrid(grid);
    const shown = matching.length;
    // The visitor can switch paging off for this visit ("Zobrazit vše", ?page=all) and back on.
    renderPager(pager, page, pages, matching.length, href);
    chips[0].setAttribute('aria-pressed', String(state.tag.length === 0));
    const choices = tagChoices(tagNames, matching.map(tagsOf), state.tag);
    // A chip that would not narrow the shown works stays, greyed and disabled (every shown work has it, or none).
    tagChips.forEach((b, i) => {
      const { count, picked, offered } = choices[i];
      b.disabled = !offered;
      b.title = offered ? '' : count ? 'Mají ho všechna zobrazená díla' : 'Nemá ho žádné zobrazené dílo';
      b.setAttribute('aria-pressed', String(picked));
      // A picked chip shows no count: all the shown works have it.
      b.querySelector('small')!.textContent = picked ? '' : String(count);
    });
    // No chips only when the works of this page have no tags at all.
    chipGroup.hidden = tagChips.length === 0;
    for (const k of selects) {
      const [all, ...options] = allOptions[k];
      const choices = facetChoices(works, state, k, options.map((o) => o.value));
      options.forEach((o, i) => { o.textContent = `${o.dataset.label} (${choices[i].count})`; });
      // No option narrows the shown works: the filter stays greyed and disabled, showing the value they all share.
      const { off, common } = facetDisplay(choices);
      const s = select(k)!;
      if (off) s.replaceChildren(common >= 0 ? options[common] : all);
      else s.replaceChildren(all, ...options.filter((_, i) => choices[i].offered));
      s.value = off ? (common >= 0 ? options[common].value : '') : state[k];
      s.disabled = off;
      const label = s.closest('label')!;
      label.classList.toggle('off', off);
      label.title = off ? 'Všechna zobrazená díla mají stejnou hodnotu, není z čeho vybírat' : '';
    }
    if (featuredBox) {
      featuredBox.checked = state.featured === FEATURED_ON;
      const [choice] = facetChoices(works, state, 'featured', [FEATURED_ON]);
      featuredCount!.textContent = String(choice.count);
      // Greyed and disabled while it changes nothing: all shown works are in the selection, or none.
      const { off } = facetDisplay([choice]);
      const label = featuredBox.closest('label')!;
      featuredBox.disabled = off;
      label.classList.toggle('off', off);
      label.title = !off ? FEATURED_TITLE : choice.count ? 'Všechna zobrazená díla jsou doporučená' : 'Žádné zobrazené dílo není doporučené';
    }
    // The field keeps what the visitor types; only a change from elsewhere (the "×" in the bar) rewrites it.
    if (searchInput && normalizeQuery(searchInput.value) !== state.q) searchInput.value = state.q;
    if (perPageSelect) perPageSelect.value = String(pageSizeOf(state, pageSizes));
    // The page size matters only when the shown works do not fit the smallest page of the view.
    if (perPageLabel) perPageLabel.hidden = matching.length <= pageSizes[0];
    // "12 z 58 děl" while a filter is on, and "Zrušit filtry" (panel, open panel, bar with two filters or more)
    const active = activeFilters(state, optionLabel).length;
    countEl.textContent = filteredCount(shown, cards.length, active > 0);
    for (const b of resets) b.hidden = b.classList.contains('bar-reset') ? active < 2 : active === 0;
    renderBar(shown);
    collectionCombo?.sync();
    emptyEl.hidden = shown > 0;
    const p = stateToParams(state);
    history.replaceState(null, '', p.size ? `?${p}` : location.pathname);
    // Links back here (← Tvorba, the year, the collection on a work page) return to these filters and this page.
    rememberListing(p);
    return matching.length;
  }

  // The thin filter bar: once the form is scrolled away, scrolling up slides in a line with the active filters as
  // chips, each with "×" to turn it off, the number of works and "Upravit", which opens this same form as a panel
  // (below the bar, on a phone from the bottom); scrolling down slides the bar away (scrollBar). A change in the open
  // panel or a "×" jumps to the start of the results, right below the bar, which stays.
  const bar = document.getElementById('filter-bar')!;
  const slot = document.getElementById('filters-slot')!;
  const barChips = document.getElementById('bar-chips')!;
  const barCount = document.getElementById('bar-count')!;
  const toggle = document.getElementById('filter-toggle') as HTMLButtonElement;
  const done = document.getElementById('filters-done') as HTMLButtonElement;
  // The text of a picked option in the bar: its data-chip when the option alone would be unclear ("mimo kolekce").
  function optionLabel(key: string, value: string) {
    const option = allOptions[key]?.find((o) => o.value === value);
    return option?.dataset.chip ?? option?.dataset.label ?? value;
  }
  function renderBar(count: number) {
    const items = activeFilters(state, optionLabel);
    barChips.replaceChildren(...(items.length ? items.map(({ key, value, text }) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'bar-chip';
      b.dataset.key = key;
      b.dataset.value = value;
      b.setAttribute('aria-label', `Zrušit filtr ${text}`);
      b.append(text, Object.assign(document.createElement('span'), { textContent: '×', ariaHidden: 'true' }));
      return b;
    }) : [Object.assign(document.createElement('span'), { className: 'bar-all', textContent: 'Všechna díla' })]));
    barCount.textContent = worksCount(count);
  }
  let barState = BAR_START;
  let panelOpen = false;
  // A scroll the page makes itself never slides the bar in: the pager hides it, a jump to the results keeps it.
  let quietUntil = 0;
  let quietKeeps = false;
  const quiet = (keep: boolean) => { quietUntil = performance.now() + 900; quietKeeps = keep; };
  // The form counts as on screen only below the bar (when shown), so the results right under the bar keep it.
  const formOnScreen = () => slot.getBoundingClientRect().bottom > (bar.classList.contains('shown') ? bar.offsetHeight : 0);
  const showBar = (on: boolean) => { bar.classList.toggle('shown', on); bar.inert = !on; };
  function onScroll() {
    if (panelOpen) return;
    const y = Math.min(Math.max(0, scrollY), document.documentElement.scrollHeight - innerHeight);
    if (performance.now() < quietUntil) barState = { ...BAR_START, y, turn: y, visible: quietKeeps && !formOnScreen() };
    else barState = scrollBar(barState, y, formOnScreen());
    // Keyboard focus in the bar keeps it, unless the form itself is back on screen.
    showBar(barState.visible || (bar.classList.contains('shown') && bar.contains(document.activeElement) && !formOnScreen()));
  }
  let ticking = false;
  addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => { ticking = false; onScroll(); });
  }, { passive: true });
  function openPanel() {
    panelOpen = true;
    slot.style.minHeight = `${slot.offsetHeight}px`; // the page keeps its place while the form floats
    form.style.setProperty('--bar-h', `${bar.offsetHeight}px`);
    form.classList.add('floating');
    toggle.setAttribute('aria-expanded', 'true');
    toggle.textContent = 'Zavřít';
    form.querySelector<HTMLElement>('button:not([hidden]), select')?.focus({ preventScroll: true });
  }
  function closePanel(focusToggle: boolean) {
    if (!panelOpen) return;
    panelOpen = false;
    form.classList.remove('floating');
    slot.style.minHeight = '';
    toggle.setAttribute('aria-expanded', 'false');
    toggle.textContent = 'Upravit';
    barState = { ...barState, visible: !formOnScreen(), y: scrollY, turn: scrollY };
    showBar(barState.visible);
    // Keyboard focus back to the bar, or into the form when that is on screen again (the bar then hides).
    if (focusToggle) (barState.visible ? toggle : form.querySelector<HTMLElement>('button:not([hidden]), select'))?.focus({ preventScroll: true });
  }
  toggle.addEventListener('click', () => (panelOpen ? closePanel(true) : openPanel()));
  done.addEventListener('click', () => closePanel(true));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && panelOpen) closePanel(true); });
  document.addEventListener('pointerdown', (e) => {
    if (panelOpen && !form.contains(e.target as Node) && !bar.contains(e.target as Node)) closePanel(false);
  });
  /** After a change in the open panel (or any, `always`): to the start of the results, right below the bar. */
  function toResults(always = false) {
    if (!panelOpen && !always) return;
    quiet(true);
    scrollTo({ top: grid.getBoundingClientRect().top + scrollY - bar.offsetHeight - 16 });
  }

  // "×" on a chip of the bar: that filter off; the keyboard focus moves to the next chip, or to "Upravit".
  barChips.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('.bar-chip');
    if (!chip) return;
    const at = [...barChips.children].indexOf(chip);
    state = withoutFilter(state, { key: chip.dataset.key!, value: chip.dataset.value! });
    trackFilter(apply());
    toResults(true);
    const next = barChips.querySelectorAll<HTMLButtonElement>('.bar-chip')[at] ?? barChips.querySelector<HTMLButtonElement>('.bar-chip:last-of-type') ?? toggle;
    next.focus({ preventScroll: true });
  });

  // "Zrušit filtry" / "Zrušit vše": every filter off at once (the year or collection of its own page stays, it is
  // the address); from the bar the focus moves to "Upravit", the button itself is gone.
  for (const b of resets) {
    b.addEventListener('click', () => {
      state = withoutFilters(state);
      trackFilter(apply());
      if (b.classList.contains('bar-reset')) {
        toResults(true);
        toggle.focus({ preventScroll: true });
      } else toResults();
    });
  }

  // Statistics: every filter change (not paging, not the page size) with the active filters and the result count.
  const trackFilter = (results: number) => trackEvent(EVENTS.filter, filterEventParams(state, results));

  // A new filter starts again on the first page.
  chips.forEach((b) => b.addEventListener('click', () => { state.tag = b.dataset.value ? toggleTag(state.tag, b.dataset.value) : []; state.page = pageAfterFilterChange(state.page); trackFilter(apply()); toResults(); }));
  form.addEventListener('change', () => {
    // Greyed (disabled) filters only show the value all works share: never read as a choice (stateFromForm).
    state = stateFromForm(state, [
      ...selects.map((k) => ({ key: k, value: select(k)!.value, off: select(k)!.disabled })),
      ...(featuredBox ? [{ key: 'featured', value: featuredBox.checked ? FEATURED_ON : '', off: featuredBox.disabled }] : []),
    ]);
    state.page = pageAfterFilterChange(state.page);
    trackFilter(apply());
    toResults();
  });
  // The search filters as the visitor types (back to page 1, no jump: the field stays where it is); statistics only
  // once the query is done (Enter, leaving the field), not for every letter.
  searchInput?.addEventListener('input', () => {
    state.q = normalizeQuery(searchInput.value);
    state.page = pageAfterFilterChange(state.page);
    apply();
    syncSearchHint();
  });
  searchInput?.addEventListener('focus', syncSearchHint);
  searchInput?.addEventListener('blur', syncSearchHint);
  // Enter on the exact id of a shown work (from the Instagram post or the pin) opens its page; the gallery stays in
  // the history with the query (?q=<id>), so Back returns to it. Never while typing, never for a part of an id.
  searchInput?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' || e.isComposing) return;
    const id = exactId(searchInput.value, cardIds);
    const card = id ? (cards.find((c) => c.dataset.id === id) as HTMLAnchorElement | undefined) : undefined;
    if (!card) return;
    e.preventDefault();
    location.assign(card.href);
  });
  searchInput?.addEventListener('change', () => trackFilter(cards.filter((_, i) => matchesFilters(works[i], state)).length));
  // Picking a page size (under the grid) starts again on page 1 with paging on, from the top of the works.
  perPageSelect?.addEventListener('change', () => {
    state = withPageSize(state, Number(perPageSelect.value), pageSizes);
    sizeStorage(state.view).set(pageSizeToRemember(Number(perPageSelect.value), pageSizes));
    apply();
    quiet(false);
    slot.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  // Switching the view keeps the filters; the page size becomes that of the view (remembered or its default) and the
  // page the one with the first work shown so far (withView).
  for (const b of viewButtons) {
    b.addEventListener('click', () => {
      const next = b.dataset.view ?? DEFAULT_VIEW;
      if (next === state.view) return;
      state = withView(state, next, sizes, sizeStorage(next).get());
      pageSizes = viewPageSizes(state.view, sizes);
      fillPageSizes();
      viewStorage.set(viewToRemember(state.view));
      apply();
      trackEvent(EVENTS.view, viewEventParams('gallery', state));
      quiet(false);
    });
  }
  // Smaller or larger tiles: only the width of the columns changes, the works and the page stay.
  for (const b of tileSteps) {
    b.addEventListener('click', () => {
      state.tile = stepTileSize(state.tile, Number(b.dataset.tileStep));
      tileStorage.set(tileSizeToRemember(state.tile));
      apply();
      trackEvent(EVENTS.view, viewEventParams('gallery', state));
      quiet(false);
    });
  }
  pager.addEventListener('click', (e) => {
    const page = pagerTarget(e);
    if (page === null) return; // let "open in new tab" work
    e.preventDefault();
    state.page = page;
    apply();
    quiet(false);
    slot.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  apply();
  // Another width: other columns, laid out again; the titles under big pictures may wrap differently once the web
  // fonts are in.
  let gridWidth = grid.clientWidth;
  let relayout = false;
  addEventListener('resize', () => {
    if (relayout) return;
    relayout = true;
    requestAnimationFrame(() => {
      relayout = false;
      if (grid.clientWidth === gridWidth) return;
      gridWidth = grid.clientWidth;
      balanceGrid(grid);
    });
  });
  document.fonts?.ready.then(() => { if (state.view === 'grid') balanceGrid(grid); });

  // Back from a work page (← Tvorba, its year or collection): to the card of that work, when on the shown page.
  revealReturned(cards, 'id');
</script>

