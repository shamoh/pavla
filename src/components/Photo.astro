---
// A photo from pavla-content/fotky/<name>.jpg. Renders nothing while the photo does not exist yet.
// `aspect` (e.g. "2 / 1") crops the photo to that shape, centred on the photo's `focus` point from its YAML.
import Img from './Img.astro';
import { getPhoto } from '../lib/site';

interface Props { name: string; sizes: string; eager?: boolean; class?: string; caption?: boolean; aspect?: string }
const { name, sizes, eager, class: cls, caption = true, aspect } = Astro.props;
const photo = getPhoto(name);
const [fx, fy] = photo?.focus ?? [50, 50];
---
{photo && (
  <figure class:list={['photo', cls, { cropped: aspect }]} style={aspect ? `--aspect: ${aspect}; --focus: ${fx}% ${fy}%` : undefined}>
    <Img base={`/photos/${name}`} image={photo} alt={photo.alt} sizes={sizes} eager={eager} />
    {caption && photo.caption && <figcaption>{photo.caption}</figcaption>}
  </figure>
)}
<style>
  .photo { margin: 0; }
  .cropped :global(picture) { aspect-ratio: var(--aspect); overflow: hidden; }
  .cropped :global(img) { height: 100%; object-fit: cover; object-position: var(--focus); }
  figcaption { margin-top: 10px; font-size: 0.85rem; color: var(--ink-soft); }
</style>
