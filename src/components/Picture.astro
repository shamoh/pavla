---
import Img from './Img.astro';
import { type Work, workImagePath } from '../lib/site';

interface Props { work: Work; sizes: string; eager?: boolean; class?: string }
const { work, sizes, eager, class: cls } = Astro.props;
---
<Img base={workImagePath(work)} image={work.image} alt={`${work.title} — ${work.technique}`} sizes={sizes} eager={eager} class={cls} />
