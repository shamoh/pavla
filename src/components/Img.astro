---
// Responsive <picture> for any generated image set: <base>/<prefix><width>.{avif,webp,jpg}.
// `cutout` when the surroundings are transparent: whoever gives the picture a shadow uses filter: var(--drop-…)
// for it (a box-shadow would show the rectangle of the image). `title`: the tooltip over the image (workTooltip).
import { url, type ImageSet } from '../lib/site';

interface Props { base: string; prefix?: string; image: ImageSet; alt: string; sizes: string; eager?: boolean; class?: string; title?: string }
const { base, prefix = '', image, alt, sizes, eager = false, class: cls, title } = Astro.props;
const { widths, width, height, dominant, transparent } = image;
const root = `${url(base)}/${prefix}`;
const set = (ext: string) => widths.map((w) => `${root}${w}.${ext} ${w}w`).join(', ');
const fallback = `${root}${widths.find((w) => w >= 960) ?? widths[widths.length - 1]}.jpg`;
---
<picture class:list={[cls, { cutout: transparent }]} style={transparent ? undefined : `--ph:${dominant}`}>
  <source type="image/avif" srcset={set('avif')} sizes={sizes} />
  <source type="image/webp" srcset={set('webp')} sizes={sizes} />
  <img
    src={fallback}
    srcset={set('jpg')}
    sizes={sizes}
    width={width}
    height={height}
    alt={alt}
    title={title}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : 'auto'}
  />
</picture>
<style>
  picture { display: block; background: var(--ph); }
  /* a work cut out of its photo (meta_corners): the page shows through around the paper, so no placeholder */
  picture.cutout { background: none; }
  img { display: block; width: 100%; height: auto; }
</style>
